<%
const m = it.menu
const sections = m.sections || []
const callouts = m.callouts || []
const tagsByCode = Object.fromEntries((m.dietary_tags || []).map(t => [t.code, t]))
function fmtPrice(p) {
  if (p == null) return ''
  const n = Number(p) / 100
  return '£' + n.toFixed(2)
}
const hideGroupHeaders = !!m.print_hide_variant_group_headers
const hideZeroPriced   = !!m.hide_zero_priced_variants
const hideUnpriced     = !!m.hide_unpriced_variants
// Variant option prices only — a NULL price already renders as '' via
// fmtPrice above; this treats an explicit 0 (an "included, no upcharge"
// option) the same way when the operator has opted in, without touching
// the base dish price shown via fmtPrice(item.price_pence).
function fmtVariantPrice(p) {
  if (hideZeroPriced && Number(p) === 0) return ''
  return fmtPrice(p)
}
// "Not priced" — no price at all, distinct from hideZeroPriced above
// (which keeps the option but drops just its "£0.00" text). This drops
// the option row entirely, label included. Group-attached options are
// never actually NULL (the DB defaults an option's price to 0), so in
// practice this and hideZeroPriced target the same rows — kept as
// separate flags since an operator may want one behaviour without the
// other, and legacy one-off variants can still be NULL.
function isUnpriced(p) { return p == null || Number(p) === 0 }
const cols = m.print_columns || 4
const tenantName = m.tenant_name || ''

/* Paper size + orientation drive both the on-screen page box (.page)
   and the @page print rule below. Keep these two in sync — .page is
   what the operator sees while deciding layout, @page is what the
   printer/PDF driver actually honours. */
const paperSize = m.print_paper_size === 'A3' ? 'A3' : 'A4'
const orientation = m.print_orientation === 'portrait' ? 'portrait' : 'landscape'
const PAPER_MM = { A4: [210, 297], A3: [297, 420] }
const paperDims = PAPER_MM[paperSize]
const pageWidthMm = orientation === 'landscape' ? paperDims[1] : paperDims[0]
const pageHeightMm = orientation === 'landscape' ? paperDims[0] : paperDims[1]

/* Print layout (menus.print_settings + menu_sections.print_*, migration 120).
   A missing setting keeps the original layout. */
const ps = m.print_settings || {}
const fontScale = Math.min(150, Math.max(70, Number(ps.font_scale) || 100)) / 100
const marginMm = (ps.margin_mm == null || ps.margin_mm === '') ? null : Number(ps.margin_mm)
const pagePadding = marginMm == null ? '8mm 12mm' : (marginMm + 'mm')
const repeatHeader = (ps.repeat_header === 'full' || ps.repeat_header === 'compact') ? ps.repeat_header : 'first'
const repeatFooter = !!ps.repeat_footer
const pageNumbers = !!ps.page_numbers
const keepAll = !!ps.keep_sections
/* Variant options per row (1-3): label + price pairs fill the columns row by row. */
const variantCols = Math.min(3, Math.max(1, Math.round(Number(ps.variant_columns) || 1)))

/* Designed pages: a section set to start on a new page opens a new sheet.
   Each sheet gets its own header, columns and footer. */
const pages = []
sections.forEach(function (s) {
  if (!pages.length || (s.print_break_before === 'page' && pages[pages.length - 1].length)) pages.push([])
  pages[pages.length - 1].push(s)
})
if (!pages.length) pages.push([])
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= m.name %> — <%= tenantName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --plum: <%= m.primary_colour || '#630812' %>;
      --plum-soft: rgba(99, 8, 18, 0.6);
      --paper: #faf6ef;
      --paper-warm: #f3ead8;
      --line: rgba(99, 8, 18, 0.18);
      --ink: #2a1c1a;
      --muted: #7a6b62;
      --chilli: #c9302c;
      --fs: <%= fontScale %>;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background: #f0ece5; color: var(--ink);
      font-family: 'Inter', sans-serif;
      font-weight: 400; line-height: 1.45;
      -webkit-font-smoothing: antialiased;
    }
    /* One .page per printed sheet. Same size and padding on screen and in
       print, so the preview is what prints and the fit check below can
       measure it. Flex column so the footer sits at the bottom of the sheet. */
    .page {
      width: <%= pageWidthMm %>mm; max-width: 100%;
      min-height: <%= pageHeightMm %>mm;
      margin: 16px auto;
      padding: <%= pagePadding %>;
      background: var(--paper);
      box-shadow: 0 4px 20px rgba(0,0,0,0.12);
      position: relative;
      display: flex; flex-direction: column;
    }
    .page.spills { display: block; }
    .page-bottom { margin-top: auto; }
    .page-num { text-align: right; font-size: 9px; color: var(--muted); padding-top: 1.5mm; }
    .fit-note { background: #fde8e8; border: 1px solid #f5b5b5; color: #8a1c1c; font-size: 12px; padding: 6px 10px; border-radius: 4px; margin-bottom: 3mm; }
    .fit-note[hidden] { display: none; }
    .fit-summary { font-size: 12px; opacity: 0.9; margin-left: 12px; }
    /* Print bar — visible on screen, hidden on print. */
    .print-bar {
      position: sticky; top: 0; z-index: 50;
      background: var(--plum); color: #f5efe6;
      padding: 10px 24px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 13px;
    }
    .print-bar button {
      background: #f5efe6; color: var(--plum);
      border: none; padding: 8px 18px; border-radius: 4px;
      font-weight: 600; cursor: pointer;
      font-family: inherit; font-size: 13px;
    }
    /* Browsers drop background colours when printing unless an element asks
       to keep them. Dietary tag chips, highlighted sections, house favourites
       and the intro banner keep theirs; the page background does not. */
    .tag-chip, .section.highlight, .item.featured, .menu-intro {
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    @media print {
      html, body { background: var(--paper); }
      .print-bar { display: none; }
      /* Vertical padding tighter than horizontal — measured with headless
         Chrome (page.pdf + scrollHeight) against a realistic full 4-column
         menu (header + intro banner + 4 sections + 4-column callouts
         footer): that content needed ~198mm inside an A4-landscape page's
         186mm usable height (210mm - 2x12mm), spilling ~12mm onto a mostly
         blank second sheet. The 12mm print margin in Chrome's "Minimum"
         setting doesn't stack on top of this — it's the content itself
         that was too tall. Reclaimed here plus in .menu-head/.section/
         .item/.callouts/.menu-foot below, well past the ~12mm actually
         needed, so moderately denser menus than this test case still fit
         one page. Re-measure with the same method before loosening any
         of these if a menu still spills to a second sheet. */
      /* 100vh is the printable area; a printer that keeps its own margins
         would otherwise push a paper-height sheet onto an extra blank page. */
      .page { box-shadow: none; margin: 0; min-height: calc(100vh - 1mm); break-after: page; }
      .page:last-child { break-after: auto; }
      .fit-note { display: none !important; }
      @page { size: <%= paperSize %> <%= orientation %>; margin: 0; }
    }
    /* Header */
    .menu-head { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 4mm; border-bottom: 1px solid var(--line); margin-bottom: 4mm; gap: 12mm; }
    .menu-head h1 { font-family: 'Fraunces', serif; font-size: calc(28px * var(--fs)); font-weight: 500; color: var(--ink); letter-spacing: -0.01em; line-height: 1; }
    .menu-head .tagline { font-family: 'Caveat', cursive; font-size: calc(18px * var(--fs)); color: var(--plum); margin-top: 2px; }
    .menu-head .right { text-align: right; font-size: calc(11px * var(--fs)); color: var(--muted); line-height: 1.5; }
    .menu-head .right strong { color: var(--ink); display: block; font-size: calc(11px * var(--fs)); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; }
    .menu-logo { width: 18mm; height: 18mm; object-fit: contain; flex-shrink: 0; }
    .menu-head.compact { align-items: baseline; padding-bottom: 2mm; margin-bottom: 3mm; }
    .menu-head.compact .compact-name { font-family: 'Fraunces', serif; font-size: calc(14px * var(--fs)); font-weight: 500; color: var(--ink); }
    .menu-head.compact .compact-right { font-size: calc(10px * var(--fs)); color: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; }
    .menu-intro { background: var(--paper-warm); padding: 6px 10px; font-size: calc(11px * var(--fs)); color: var(--muted); border-radius: 3px; margin-bottom: 3mm; }
    .menu-intro strong { color: var(--ink); margin-right: 4px; text-transform: uppercase; letter-spacing: 0.08em; font-size: calc(10px * var(--fs)); }

    /* Columns grid */
    .cols { column-count: <%= cols %>; column-gap: 6mm; column-fill: balance; }
    /* Screen-only collapse for narrow phone viewports. Without the
       "screen and" qualifier this also matched during print — the printer's
       selected paper width (e.g. portrait A4/Letter, ~794-816px) falls
       under 800px, so it silently forced single-column print output even
       though the on-screen preview (wider window) never triggered it and
       @page below sets landscape. Never drop "screen and" here. */
    @media screen and (max-width: 800px) { .cols { column-count: 1 !important; } }
    .section { margin-bottom: 4mm; }
    /* Keep a section in one piece (per section, or every section via
       print_settings.keep_sections), and start a section in a new column. */
    .section.keep { break-inside: avoid; }
    .section.col-break { break-before: column; }
    .section.highlight { background: #fff7e6; padding: 4mm; border-radius: 4px; }
    .section h2 { font-family: 'Inter', sans-serif; font-size: calc(12px * var(--fs)); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink); }
    .section .sub { font-size: calc(10px * var(--fs)); font-weight: 400; color: var(--muted); margin-left: 6px; text-transform: none; letter-spacing: 0; }
    .section .head-row { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; padding-bottom: 1.5mm; margin-bottom: 2mm; border-bottom: 1px solid var(--line); break-after: avoid; }

    /* Items. break-inside is on the item (not the section): a section
       with many dishes (e.g. a 15-item Starters list) needs to be able to
       split across columns/pages. Keeping break-inside: avoid on the
       whole .section instead forces the ENTIRE section to jump to the
       next column/page the moment it doesn't fit in the remaining space
       — leaving the column it vacated mostly blank and confusing Chrome's
       column-balance calculation, which is what produced the blank-gap /
       wrong-page-count print output. Avoiding the split at the .item
       level instead keeps each dish's own name+price+description intact
       without forcing whole sections to relocate. */
    .item { padding: 1.2mm 0; break-inside: avoid; }
    .item-thumb { width: 9mm; height: 9mm; object-fit: cover; border-radius: 2px; flex-shrink: 0; }
    .item-body { flex: 1; min-width: 0; }
    .group-name { font-size: calc(9px * var(--fs)); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-top: 1.5mm; }
    .item.featured { background: var(--paper-warm); padding: 2mm 3mm; border-radius: 3px; margin-bottom: 1.5mm; }
    .item-row { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; }
    .item-name { font-size: calc(11.5px * var(--fs)); font-weight: 500; color: var(--ink); }
    .item-name .native { font-style: italic; font-weight: 300; color: var(--muted); font-size: calc(10px * var(--fs)); margin-left: 4px; }
    .item-price { font-family: 'Fraunces', serif; font-size: calc(11.5px * var(--fs)); font-weight: 500; color: var(--plum); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .item-desc { font-size: calc(10.5px * var(--fs)); color: var(--muted); margin-top: 1px; line-height: 1.4; }
    .item-notes { font-size: calc(9.5px * var(--fs)); color: var(--plum-soft); font-style: italic; margin-top: 1px; }
    .item-tags { display: inline-flex; gap: 3px; margin-left: 4px; vertical-align: middle; }
    .tag-chip { display: inline-flex; align-items: center; justify-content: center; min-width: 14px; height: 14px; padding: 0 4px; border-radius: 3px; color: #fff; font-size: calc(9px * var(--fs)); font-weight: 700; line-height: 1; }
    .tag-star { align-self: flex-start; font-size: .85em; margin-left: 1px; }
    /* Variants */
    .variants { display: grid; grid-template-columns: repeat(<%= variantCols %>, minmax(0, 1fr)); gap: 0 4mm; margin-top: 1mm; }
    .variant { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; min-width: 0; }
    .variant-label { font-size: calc(10.5px * var(--fs)); color: var(--ink); }
    .variant-price { font-family: 'Fraunces', serif; font-size: calc(10.5px * var(--fs)); color: var(--plum); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }

    /* Callouts (footer notes) */
    .callouts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6mm; margin-top: 4mm; padding-top: 3mm; border-top: 1px solid var(--line); font-size: calc(10px * var(--fs)); }
    .callout strong { display: block; font-size: calc(10px * var(--fs)); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); margin-bottom: 2px; font-weight: 600; }
    .callout p { color: var(--muted); white-space: pre-line; line-height: 1.45; }
    .callout .key { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2mm; }
    .callout .key .pair { display: inline-flex; align-items: center; gap: 4px; font-size: calc(9.5px * var(--fs)); }

    /* Footer line */
    .menu-foot { text-align: center; padding-top: 3mm; font-family: 'Fraunces', serif; font-style: italic; color: var(--muted); font-size: calc(10px * var(--fs)); }
  </style>
</head>
<body>
  <div class="print-bar">
    <span><%= m.name %> — <%= tenantName %> <% if (m.service_times) { %> · <%= m.service_times %><% } %>
      <span class="fit-summary" id="fit-summary"></span></span>
    <button onclick="window.print()">Save as PDF / Print</button>
  </div>
  <% pages.forEach(function(group, pi){ %>
  <% const isFirst = pi === 0 %>
  <% const isLast = pi === pages.length - 1 %>
  <div class="page" data-page="<%= pi + 1 %>" data-w="<%= pageWidthMm %>" data-h="<%= pageHeightMm %>">
    <div class="fit-note" hidden></div>
    <% if (isFirst || repeatHeader === 'full') { %>
    <div class="menu-head">
      <div>
        <h1><%= m.name %></h1>
        <% if (m.tagline) { %><div class="tagline"><%= m.tagline %></div><% } %>
      </div>
      <% if (m.logo_url) { %><img class="menu-logo" src="<%= m.logo_url %>" alt="" /><% } %>
      <div class="right">
        <strong><%= tenantName %></strong>
        <% if (m.address_line1) { %><div><%= m.address_line1 %><% if (m.postcode) { %>, <%= m.postcode %><% } %></div><% } %>
        <% if (m.phone) { %><div><%= m.phone %></div><% } %>
        <% if (m.service_times) { %><div><%= m.service_times %></div><% } %>
      </div>
    </div>
    <% } else if (repeatHeader === 'compact') { %>
    <div class="menu-head compact">
      <span class="compact-name"><%= m.name %></span>
      <span class="compact-right"><%= tenantName %></span>
    </div>
    <% } %>

    <% if (isFirst && m.intro_line) { %>
      <div class="menu-intro"><%~ m.intro_line %></div>
    <% } %>

    <div class="cols">
      <% group.forEach(function(s, si){ %>
        <% const _keep = keepAll || !!s.print_keep_together %>
        <% const _colBreak = si > 0 && s.print_break_before === 'column' %>
        <div class="section<%= s.highlight ? ' highlight' : '' %><%= _keep ? ' keep' : '' %><%= _colBreak ? ' col-break' : '' %>">
          <div class="head-row">
            <h2>
              <% if (s.image_url) { %><img src="<%= s.image_url %>" alt="" style="width:1.6em; height:1.6em; object-fit:cover; border-radius:3px; vertical-align:middle; margin-right:4px;" /><% } %>
              <%= s.title %><% if (s.subtitle) { %><span class="sub"><%= s.subtitle %></span><% } %>
            </h2>
          </div>
          <% const _printItems = s.items || [] %>
          <% _printItems.forEach(function(item){ %>
            <% const _groups = (item.variant_groups || [])
                 .map(function(g){
                   if (!hideUnpriced) return g
                   return Object.assign({}, g, { options: (g.options || []).filter(function(v){ return !isUnpriced(v.price_pence) }) })
                 })
                 .filter(function(g){ return !hideUnpriced || (g.options && g.options.length) }) %>
            <% const _adhoc = hideUnpriced
                 ? (item.variants || []).filter(function(v){ return !isUnpriced(v.price_pence) })
                 : (item.variants || []) %>
            <% const _hasVar = (_adhoc.length > 0) || _groups.some(function(g){ return g.options && g.options.length }) %>
            <div class="item<%= item.is_featured ? ' featured' : '' %>">
              <div class="item-row" style="align-items:flex-start; gap: 2mm;">
                <% if (item.image_url) { %>
                  <img class="item-thumb" src="<%= item.image_url %>" alt="" />
                <% } %>
                <div class="item-body">
              <div class="item-row">
                <div>
                  <span class="item-name">
                    <%= item.name %>
                    <% if (item.native_name) { %><span class="native"><%= item.native_name %></span><% } %>
                  </span>
                  <% if (item.dietary && item.dietary.length) { %>
                    <span class="item-tags">
                      <% item.dietary.forEach(function(code){ %>
                        <% const tag = tagsByCode[code] %>
                        <% const removable = (item.allergen_levels || {})[code] === 'removable' %>
                        <% if (tag) { %>
                          <span class="tag-chip" style="background: <%= tag.colour %>;" title="<%= tag.label %><%= removable ? ' (' + it.key.removable_note.toLowerCase() + ')' : '' %>"><%= tag.glyph %><% if (removable) { %><span class="tag-star">*</span><% } %></span>
                        <% } %>
                      <% }) %>
                    </span>
                  <% } %>
                </div>
                <% if (item.price_pence != null && !_hasVar) { %>
                  <span class="item-price"><%= fmtPrice(item.price_pence) %></span>
                <% } %>
              </div>
              <% if (item.description) { %><div class="item-desc"><%= item.description %></div><% } %>
              <% if (item.notes) { %><div class="item-notes"><%= item.notes %></div><% } %>
              <% if (item.calories != null) { %><div class="item-notes"><%= item.calories %> kcal</div><% } %>
              <% _groups.forEach(function(g){ %>
                <% if (g.name && !hideGroupHeaders) { %><div class="group-name"><%= g.name %></div><% } %>
                <% if (g.options && g.options.length) { %>
                  <div class="variants">
                    <% g.options.forEach(function(v){ %>
                      <span class="variant"><span class="variant-label"><%= v.label %></span><span class="variant-price"><%= fmtVariantPrice(v.price_pence) %></span></span>
                    <% }) %>
                  </div>
                <% } %>
              <% }) %>
              <% if (_adhoc.length) { %>
                <div class="variants">
                  <% _adhoc.forEach(function(v){ %>
                    <span class="variant"><span class="variant-label"><%= v.label %></span><span class="variant-price"><%= fmtVariantPrice(v.price_pence) %></span></span>
                  <% }) %>
                </div>
              <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>

    <% if (isLast || repeatFooter || pageNumbers) { %>
    <div class="page-bottom">
    <% if (isLast || repeatFooter) { %>
    <% if (callouts.length) { %>
      <div class="callouts">
        <% callouts.forEach(function(c){ %>
          <div class="callout">
            <% if (c.kind === 'allergens') { %>
              <% /* The allergen notice (migration 147) replaces the note words. */ %>
              <% const _key = it.key %>
              <% if (_key.title) { %><strong><%= _key.title %></strong><% } %>
              <% if (_key.body) { %><p><%= _key.body %></p><% } %>
              <% if (_key.tags.length || _key.removable) { %>
                <div class="key">
                  <% _key.tags.forEach(function(tag){ %>
                    <span class="pair">
                      <span class="tag-chip" style="background: <%= tag.colour %>;"><%= tag.glyph %></span>
                      <%= tag.label %>
                    </span>
                  <% }) %>
                  <% if (_key.removable) { %><span class="pair">* <%= _key.removable_note %></span><% } %>
                </div>
              <% } %>
            <% } else { %>
              <strong><%= c.title %></strong>
              <% if (c.body) { %><p><%= c.body %></p><% } %>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (m.footer_motto) { %>
      <div class="menu-foot"><%= m.footer_motto %></div>
    <% } else { %>
      <div class="menu-foot">— honest cooking, made fresh in our kitchen —</div>
    <% } %>
    <% } %>
    <% if (pageNumbers) { %><div class="page-num">Page <%= pi + 1 %> of <%= pages.length %></div><% } %>
    </div>
    <% } %>
  </div>
  <% }) %>

  <script>
  /* Fit check (screen only). Each .page is one printed sheet: if its content
     is taller than the sheet it would spill onto an extra, header-less sheet
     when printed, so say so on the page. A spilling page also drops its
     flex layout (class "spills") so the print engine can break it cleanly.
     Skipped when the window is too narrow to show the page at full size,
     since the layout then differs from print. */
  (function () {
    var MM = 96 / 25.4;
    function check() {
      var pages = document.querySelectorAll('.page');
      var bad = [];
      var measured = true;
      pages.forEach(function (pg) {
        var note = pg.querySelector('.fit-note');
        pg.classList.remove('spills');
        note.hidden = true;
        var wantW = parseFloat(pg.getAttribute('data-w')) * MM;
        var wantH = parseFloat(pg.getAttribute('data-h')) * MM;
        if (Math.abs(pg.offsetWidth - wantW) > 2) { measured = false; return; }
        var over = pg.offsetHeight - wantH;
        if (over > 2) {
          var mm = Math.ceil(over / MM);
          pg.classList.add('spills');
          note.textContent = 'This page doesn\'t fit on one sheet: about ' + mm + 'mm too long. Start a section on a new page, let long sections split, or make the font smaller.';
          note.hidden = false;
          bad.push(pg.getAttribute('data-page'));
        }
      });
      var sum = document.getElementById('fit-summary');
      if (!sum) return;
      var n = pages.length + (pages.length === 1 ? ' page' : ' pages');
      if (!measured) sum.textContent = '· ' + n + ' · widen the window to check the fit';
      else if (bad.length) sum.textContent = '· ' + n + ' · page ' + bad.join(', ') + ' too long';
      else sum.textContent = '· ' + n + ' · all fit';
    }
    function run() { if (document.fonts && document.fonts.ready) document.fonts.ready.then(check); else check(); }
    window.addEventListener('load', run);
    window.addEventListener('resize', run);
  })();
  </script>
</body>
</html>
