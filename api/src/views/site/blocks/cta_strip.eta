<%
const d = it.block.data || {}
const bgMap = {
  primary: 'background:var(--c-primary); color:#fff;',
  accent:  'background:var(--c-accent); color:#fff;',
  dark:    'background:#111; color:#fff;',
  light:   'background:var(--c-surface); color:var(--c-text);',
}
const bg = bgMap[d.bg_style || 'primary']
const fg = d.bg_style === 'light' ? 'var(--c-text)' : '#fff'
const primaryBg = (d.bg_style === 'light') ? 'var(--c-primary)' : '#fff'
const primaryFg = (d.bg_style === 'light') ? '#fff' : 'var(--c-primary)'
const innerMax = d.container === 'full' ? 'none' : d.container === 'wide' ? '1100px' : '780px'
const boxedSteps = (it.config && it.config.theme && it.config.theme.spacing && it.config.theme.spacing.boxed_steps && it.config.theme.spacing.boxed_steps.length === 5)
  ? it.config.theme.spacing.boxed_steps
  : [{ value: 16, unit: 'px' }, { value: 24, unit: 'px' }, { value: 40, unit: 'px' }, { value: 64, unit: 'px' }, { value: 96, unit: 'px' }]
const boxedStepCfg = boxedSteps[Number(d.boxed_step) - 1] || boxedSteps[1]
const pad = d.boxed_step ? (boxedStepCfg.value + (boxedStepCfg.unit || 'px')) : 'var(--boxed-pad, 24px)'
const containerStyle = d.container === 'full'
  ? 'width:100%; padding:0 ' + pad + ';'
  : 'max-width:' + innerMax + '; margin:0 auto; padding:0 ' + pad + ';'
const ctas = Array.isArray(d.ctas) ? d.ctas : []
%>
<section class="block" style="<%= bg %> padding:48px 0; text-align:center;">
  <div style="<%= containerStyle %>">
    <% if (d.heading) { %>
      <h2 style="font-family:var(--f-heading); margin:0 0 8px;">
        <%= d.heading %>
      </h2>
    <% } %>
    <% if (d.subheading) { %>
      <p style="font-size:17px; opacity:0.9; margin:0 0 20px;"><%= d.subheading %></p>
    <% } %>
    <% if (ctas.length) { %>
      <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <% ctas.forEach(function(cta){ %>
          <% if (cta.text) { %>
            <% const isPrimary = cta.style !== 'secondary' %>
            <% const btnBg  = isPrimary ? primaryBg : 'transparent' %>
            <% const btnFg  = isPrimary ? primaryFg : fg %>
            <% const border = isPrimary ? 'none' : ('2px solid ' + fg) %>
            <a href="<%= cta.link || '#' %>"
               style="display:inline-block;
                      background:<%= btnBg %>; color:<%= btnFg %>; border:<%= border %>;
                      padding:14px 32px; border-radius:var(--btn-radius, 4px);
                      font-weight:600; text-decoration:none;">
              <%= cta.text %>
            </a>
          <% } %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
