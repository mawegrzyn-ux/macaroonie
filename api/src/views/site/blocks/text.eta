<%
const d = it.block.data || {}
const widthMap = { narrow: 700, normal: 980, wide: 1200 }
const maxW = widthMap[d.max_width || 'normal']
const bg = d.background === 'surface' ? 'background:var(--c-surface);'
         : d.background === 'accent'  ? 'background:var(--c-accent); color:#fff;'
         : ''
const cw = d.container === 'wide' ? '1400px' : d.container === 'full' ? 'none' : 'var(--cw)'
const padMap = { 1: '16px', 2: '24px', 3: '40px', 4: '64px', 5: '96px' }
const pad = padMap[d.boxed_step] || 'var(--boxed-pad, 24px)'
const containerStyle = d.container === 'full'
  ? 'width:100%; padding:0 ' + pad + ';'
  : 'max-width:' + cw + '; margin:0 auto; padding:0 ' + pad + ';'
%>
<section class="block" style="<%= bg %> padding:48px 0;">
  <div style="<%= containerStyle %>">
    <div style="max-width:<%= maxW %>px; margin:0 auto; text-align:<%= d.align || 'left' %>;">
      <div class="prose"><%~ d.html || '' %></div>
    </div>
  </div>
</section>
