<%
// Block renderer dispatch — switches on block.type and includes the right partial.
// Receives `it.block`, `it.config`, `it.venue`, `it.gallery`, `it.menus`,
// `it.opening_hours`, `it.allergens`, `it.tenant_site`, `it.venues`, `it.pages`.
const t = it.block.type
const d = it.block.data || {}
const _rawAnchor = String((d && d.anchor_id) || '').replace(/^#/, '')
const _cleanAnchor = _rawAnchor.replace(/[^A-Za-z0-9_-]/g, '-').replace(/-{2,}/g, '-').replace(/^-+|-+$/g, '').slice(0, 60)
const _fallbackAnchor = t === 'reservations_widget' ? 'reservations'
  : t === 'opening_hours' ? 'hours'
  : t === 'find_us' ? 'find-us'
  : ''
const _aid = _cleanAnchor || _fallbackAnchor
%>
<% if (_aid) { %><div id="<%= _aid %>" class="block-anchor" style="scroll-margin-top: 5.5rem;"><% } %>
<% if (t === 'header') { %>
  <%~ include('./header', it) %>
<% } else if (t === 'footer') { %>
  <%~ include('./footer', it) %>
<% } else if (t === 'scrolling_text') { %>
  <%~ include('./scrolling_text', it) %>
<% } else if (t === 'story_with_stamp') { %>
  <%~ include('./story_with_stamp', it) %>
<% } else if (t === 'dish_list') { %>
  <%~ include('./dish_list', it) %>
<% } else if (t === 'reviews_band') { %>
  <%~ include('./reviews_band', it) %>
<% } else if (t === 'order_options') { %>
  <%~ include('./order_options', it) %>
<% } else if (t === 'menu_inline') { %>
  <%~ include('./menu_inline', it) %>
<% } else if (t === 'hero') { %>
  <%~ include('./hero', it) %>
<% } else if (t === 'text') { %>
  <%~ include('./text', it) %>
<% } else if (t === 'image') { %>
  <%~ include('./image', it) %>
<% } else if (t === 'cta_strip') { %>
  <%~ include('./cta_strip', it) %>
<% } else if (t === 'gallery') { %>
  <%~ include('./gallery', it) %>
<% } else if (t === 'opening_hours') { %>
  <%~ include('./opening_hours', it) %>
<% } else if (t === 'find_us') { %>
  <%~ include('./find_us', it) %>
<% } else if (t === 'contact') { %>
  <%~ include('./contact', it) %>
<% } else if (t === 'reservations_widget') { %>
  <%~ include('./reservations_widget', it) %>
<% } else if (t === 'menu_pdfs') { %>
  <%~ include('./menu_pdfs', it) %>
<% } else if (t === 'allergens') { %>
  <%~ include('./allergens', it) %>
<% } else if (t === 'faq') { %>
  <%~ include('./faq', it) %>
<% } else if (t === 'divider') { %>
  <%~ include('./divider', it) %>
<% } else if (t === 'columns') { %>
  <%~ include('./columns', it) %>
<% } %>
<% if (_aid) { %></div><% } %>
