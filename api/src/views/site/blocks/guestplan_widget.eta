<%
/* ── guestplan_widget block ───────────────────────────────────────────
 *
 * Embeds a third-party Guestplan reservations widget via their official
 * loader script (https://cdn.guestplan.com/widget.js), loaded with the
 * page. Guestplan's script mounts itself (its own floating button and
 * booking form, which it may open by itself on a desktop); there's no
 * iframe URL or container element we control, and no documented
 * colour/theme API for the embed snippet itself, so this can't be wired
 * to the site theme the way our own reservations_widget block is. Look
 * and feel is whatever Guestplan configures against the access key on
 * their side, plus whatever the operator pastes into the optional custom
 * CSS field as a manual, best-effort override.
 *
 * We used to put our own button in front and load Guestplan on its first
 * tap (keeps the form closed on desktop), but tapping Guestplan's
 * launcher for the visitor didn't open the form on the live site, so the
 * visitor had to tap twice. Guestplan's own button is the only one now.
 *
 * Guestplan doesn't mount inside this block, so with no heading the block
 * outputs only the script and adds no empty band to the page.
 *
 * If two of these blocks somehow end up on the same page, the second
 * one just re-sets the access key rather than loading the loader script
 * twice.
 */
const d = it.block.data || {}
const innerMax = d.container === 'full' ? 'none' : d.container === 'wide' ? '900px' : '640px'
const pad = d.boxed_step ? ('var(--boxed-step-' + Number(d.boxed_step) + ')') : 'var(--boxed-pad, 24px)'
const containerStyle = d.container === 'full'
  ? 'width:100%; padding:0 ' + pad + ';'
  : 'max-width:' + innerMax + '; margin:0 auto; padding:0 ' + pad + ';'
const accessKey = String(d.access_key || '').trim()
const accessKeyJs = JSON.stringify(accessKey)
%>
<% if (!accessKey) { %>
<section class="block" style="padding:48px 0;">
  <div style="<%= containerStyle %> text-align:center;">
    <p style="color:var(--c-muted);">Guestplan widget not configured &mdash; add your access key in the block editor.</p>
  </div>
</section>
<% } else { %>
<% if (d.heading) { %>
<section class="block" style="padding:48px 0;">
  <div style="<%= containerStyle %> text-align:center;">
    <h2 style="font-family:var(--f-heading); margin:0;"><%= d.heading %></h2>
  </div>
</section>
<% } %>
<% if (d.custom_css) { %>
<style><%~ d.custom_css %></style>
<% } %>
<script>
(function () {
  if (!window._gstpln) {
    (function(g,s,t,p,l,n){
      g["_gstpln"]={};
      (l=s.createElement(t)),(n=s.getElementsByTagName(t)[0]);
      l.async=1;l.src=p;n.parentNode.insertBefore(l,n);
    })(window,document,"script","https://cdn.guestplan.com/widget.js");
  }
  window._gstpln.accessKey = <%~ accessKeyJs %>;
})();
</script>
<% } %>
