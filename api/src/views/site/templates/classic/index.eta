<%~ include('../../shared/head', it) %>
<%
const blocks = Array.isArray(it.config.home_blocks) ? it.config.home_blocks : []
const ts     = it.tenant_site || {}
%>
<%~ include('../../shared/chrome_header', { ...it, chromeBlocks: blocks, showHeader: ts.home_show_header }) %>
<main>
<% if (blocks.length === 0) { %>
  <%~ include('../../blocks/empty_state', it) %>
<% } else { %>
  <% for (const block of blocks) { %>
    <% if (block.type === 'header' || block.type === 'footer') { continue } %>
    <%~ include('../../blocks/renderer', { ...it, block }) %>
  <% } %>
<% } %>
</main>
<%~ include('../../shared/chrome_footer', { ...it, chromeBlocks: blocks, showFooter: ts.home_show_footer }) %>
</body>
</html>
