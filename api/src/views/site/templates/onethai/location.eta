<%~ include('../../shared/head', it) %>
<%
const blocks = Array.isArray(it.config.page_blocks) ? it.config.page_blocks : []
%>
<%~ include('../../shared/chrome_header', { ...it, chromeBlocks: blocks, showHeader: it.config.show_header }) %>
<main>
<% if (blocks.length === 0) { %>
  <%~ include('../../blocks/empty_state', it) %>
<% } else { %>
  <% for (const block of blocks) { %>
    <%~ include('../../blocks/renderer', { ...it, block }) %>
  <% } %>
<% } %>
</main>
<%~ include('../../shared/chrome_footer', { ...it, chromeBlocks: blocks, showFooter: it.config.show_footer }) %>
</body>
</html>
