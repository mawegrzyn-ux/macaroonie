<%
/* Web ordering pages (migration 122). Included by the Online ordering
   block (blocks/online_ordering.eta, which sits on the built-in ordering
   page and can go on any page) and by each template's order.eta (the
   order status page). One per page: the script finds #mo-app by id.
   it.orderView:
     'pick'   choose a location (multi-venue tenants)
     'order'  menu, basket, checkout and payment for it.orderVenue
     'status' one order's live status (it.orderToken)
   Prices on this page come from /order-api/pricing.js, the same module
   the server prices orders with. The server re-prices every order.
   it.orderOptions: the Online ordering block's settings (see
   blocks/online_ordering.eta); missing on the status page, so every
   option has a default here. */
const view = it.orderView
const DEFAULT_OPTS = {
  basketMode: 'side', basketSticky: true, stickyNav: true, stickyOffset: 0,
  basketBg: null, basketText: null, search: false, searchStyle: 'bar', title: null, subtitle: null,
  hideSubtitle: false, itemNotes: true, showVat: true, favourites: false,
  favouriteLabel: 'House favourite', favouriteBg: null, favouriteText: null,
}
const opts = Object.assign({}, DEFAULT_OPTS, it.orderOptions || {})
/* Only a theme variable or a #hex reaches the CSS below. */
const safeColour = function (v) { return v && /^(#[0-9a-fA-F]{6}|var[(]--c-[a-z]+[)])$/.test(v) ? v : null }
opts.basketBg = safeColour(opts.basketBg)
opts.basketText = safeColour(opts.basketText)
opts.favouriteBg = safeColour(opts.favouriteBg)
opts.favouriteText = safeColour(opts.favouriteText)
opts.stickyOffset = Math.max(0, Math.min(200, Number(opts.stickyOffset) || 0))
const optVars = '--mo-offset: ' + opts.stickyOffset + 'px;' +
  (opts.basketBg ? ' --mo-basket-bg: ' + opts.basketBg + ';' : '') +
  (opts.basketText ? ' --mo-basket-fg: ' + opts.basketText + ';' : '') +
  (opts.favouriteBg ? ' --mo-fav-bg: ' + opts.favouriteBg + ';' : '') +
  (opts.favouriteText ? ' --mo-fav-fg: ' + opts.favouriteText + ';' : '')
const rootClasses = ['mo']
if (opts.basketMode === 'modal') rootClasses.push('mo--modal-basket')
if (!opts.basketSticky) rootClasses.push('mo--static-basket')
if (!opts.stickyNav) rootClasses.push('mo--static-nav')
if (opts.favouriteText) rootClasses.push('mo--fav-fg')
const rootClass = rootClasses.join(' ')
const cfg = {
  view: view,
  venueId: it.orderVenue ? it.orderVenue.id : null,
  token: it.orderToken || null,
  statusBase: '/order/status/',
  hideTitle: !!it.orderHideTitle,
  opts: opts,
}
const cfgJson = JSON.stringify(cfg).split('<').join('\\u003c')
%>
<style>
:is(.mo, .mo-sheet-back) { <%~ optVars %> }
.mo { max-width: 1180px; margin: 0 auto; padding: 24px 16px 120px; min-width: 0; overflow-wrap: anywhere; font-family: var(--f-body, system-ui), sans-serif; color: var(--c-text, #1f2937); }
.mo *, .mo *::before, .mo *::after { box-sizing: border-box; }
.mo h1 { font-family: var(--f-heading, inherit); font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0 0 6px; }
.mo h2 { font-family: var(--f-heading, inherit); font-size: 1.35rem; margin: 28px 0 12px; }
:is(.mo, .mo-sheet-back) .mo-muted { color: var(--c-muted, #6b7280); }
.mo button { font: inherit; cursor: pointer; touch-action: manipulation; }
:is(.mo, .mo-sheet-back) .mo-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 20px; border-radius: var(--r-md, 8px); border: 1px solid transparent; background: var(--c-primary, #630812); color: #fff; font-weight: 600; }
:is(.mo, .mo-sheet-back) .mo-btn[disabled] { opacity: .5; cursor: not-allowed; }
:is(.mo, .mo-sheet-back) .mo-btn-ghost { background: transparent; color: var(--c-text, #1f2937); border-color: var(--c-border, #e5e7eb); }
:is(.mo, .mo-sheet-back) .mo-btn-block { width: 100%; }
:is(.mo, .mo-sheet-back) .mo-banner { padding: 12px 16px; border-radius: var(--r-md, 8px); background: #fef3c7; color: #92400e; margin: 12px 0; }
:is(.mo, .mo-sheet-back) .mo-error { padding: 12px 16px; border-radius: var(--r-md, 8px); background: #fee2e2; color: #991b1b; margin: 12px 0; }
/* minmax(0, ...) everywhere: a plain 1fr column grows to its widest child
   (the tab strip), so on a phone the page was wider than the screen and the
   site's overflow-x: hidden cut off tabs, cards and the right margin. */
:is(.mo, .mo-sheet-back) .mo-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; align-items: start; }
:is(.mo, .mo-sheet-back) .mo-layout > * { min-width: 0; }
:is(.mo, .mo-sheet-back) .mo-tabs { display: flex; gap: 8px; overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; scrollbar-width: none; max-width: 100%; padding: 8px 0; }
/* Search + menu tabs + category tabs stick together as one bar (option). */
.mo .mo-nav { position: sticky; top: var(--mo-offset, 0px); z-index: 5; background: var(--c-bg, #fff); padding: 4px 0; }
.mo.mo--static-nav .mo-nav { position: static; }
.mo .mo-search { position: relative; margin: 4px 0; }
.mo .mo-search input { width: 100%; min-height: 44px; padding: 0 44px 0 16px; border: 1px solid var(--c-border, #d1d5db); border-radius: 999px; font: inherit; background: var(--c-surface, #fff); color: inherit; }
.mo .mo-search input::-webkit-search-cancel-button { display: none; }
.mo .mo-search button { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border: 0; border-radius: 999px; background: transparent; color: var(--c-muted, #6b7280); font-size: 1.3rem; line-height: 1; }
.mo .mo-search input:placeholder-shown + button { display: none; }
/* Search as a round icon at the start of the category row (option): the
   icon stays put and the tabs scroll underneath it. Tapping it swaps the
   row for the search box, with a close button. */
.mo .mo-navrow { position: relative; }
.mo .mo-navrow .mo-tabs { padding-left: 58px; scroll-padding-inline: 58px 0; }
.mo .mo-navrow::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 48px; background: var(--c-bg, #fff); z-index: 1; pointer-events: none; }
.mo .mo-navrow::after { content: ''; position: absolute; left: 48px; top: 0; bottom: 0; width: 10px; background: linear-gradient(to right, var(--c-bg, #fff), transparent); pointer-events: none; z-index: 1; }
.mo .mo-search-btn { position: absolute; left: 0; top: 50%; transform: translateY(-50%); z-index: 2; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border-radius: 999px; border: 1px solid var(--c-border, #d1d5db); background: var(--c-surface, #fff); color: var(--c-text, #1f2937); box-shadow: 0 0 0 4px var(--c-bg, #fff); }
.mo .mo-search-btn svg, .mo .mo-search--open svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
.mo .mo-search--open { margin: 8px 0; }
.mo .mo-search--open svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--c-muted, #6b7280); pointer-events: none; }
.mo .mo-search--open input { padding-left: 42px; }
.mo .mo-search.mo-search--open input:placeholder-shown + button { display: block; }
:is(.mo, .mo-sheet-back) .mo-tabs::-webkit-scrollbar { display: none; }
:is(.mo, .mo-sheet-back) .mo-tab { flex: none; white-space: nowrap; min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--c-border, #e5e7eb); background: var(--c-surface, #fff); color: var(--c-text, #1f2937); }
:is(.mo, .mo-sheet-back) .mo-tab.is-on { background: var(--c-primary, #630812); color: #fff; border-color: transparent; }
:is(.mo, .mo-sheet-back) .mo-items { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 12px; }
:is(.mo, .mo-sheet-back) .mo-item { display: flex; gap: 12px; text-align: left; width: 100%; padding: 14px; border: 1px solid var(--c-border, #e5e7eb); border-radius: var(--r-md, 8px); background: var(--c-surface, #fff); color: inherit; min-height: 96px; }
:is(.mo, .mo-sheet-back) .mo-item:hover { border-color: var(--c-primary, #630812); }
:is(.mo, .mo-sheet-back) .mo-item.is-out { opacity: .55; }
/* Dishes already in the basket: primary outline plus a count badge on the
   card's corner. */
:is(.mo, .mo-sheet-back) .mo-item { position: relative; }
:is(.mo, .mo-sheet-back) .mo-item.is-in { border-color: var(--c-primary, #630812); box-shadow: 0 0 0 1px var(--c-primary, #630812); }
:is(.mo, .mo-sheet-back) .mo-item.is-in.is-fav { box-shadow: inset 4px 0 0 var(--c-accent, #d97706), 0 0 0 1px var(--c-primary, #630812); }
:is(.mo, .mo-sheet-back) .mo-in-basket { position: absolute; top: -9px; right: -9px; z-index: 1; display: inline-flex; align-items: center; gap: 3px; min-width: 26px; height: 26px; padding: 0 8px; border-radius: 999px; background: var(--c-primary, #630812); color: var(--c-bg, #fff); font-size: .8rem; font-weight: 700; line-height: 1; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
:is(.mo, .mo-sheet-back) .mo-in-basket svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
:is(.mo, .mo-sheet-back) .mo-item-body { flex: 1; min-width: 0; }
:is(.mo, .mo-sheet-back) .mo-item-name { font-weight: 600; }
:is(.mo, .mo-sheet-back) .mo-item.is-fav { border-color: var(--c-accent, #d97706); box-shadow: inset 4px 0 0 var(--c-accent, #d97706); background: var(--mo-fav-bg, var(--c-surface, #fff)); color: var(--mo-fav-fg, inherit); }
.mo.mo--fav-fg .mo-item.is-fav :is(.mo-fav, .mo-item-desc) { color: inherit; }
.mo.mo--fav-fg .mo-item.is-fav .mo-item-desc { opacity: .8; }
:is(.mo, .mo-sheet-back) .mo-fav { display: inline-flex; align-items: center; gap: 4px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--c-accent, #b45309); margin-bottom: 4px; }
:is(.mo, .mo-sheet-back) .mo-fav svg { width: 12px; height: 12px; fill: currentColor; }
:is(.mo, .mo-sheet-back) .mo-item-desc { font-size: .9rem; color: var(--c-muted, #6b7280); margin-top: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
:is(.mo, .mo-sheet-back) .mo-item-price { margin-top: 8px; font-weight: 600; }
:is(.mo, .mo-sheet-back) .mo-item img { width: 84px; height: 84px; object-fit: cover; border-radius: var(--r-md, 8px); flex: none; }
:is(.mo, .mo-sheet-back) .mo-tag { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 4px; color: #fff; font-size: 11px; font-weight: 700; margin-right: 4px; }
:is(.mo, .mo-sheet-back) .mo-min { display: inline-block; font-size: .72rem; font-weight: 700; padding: 1px 7px; border-radius: 999px; border: 1px solid currentColor; opacity: .75; margin-left: 4px; vertical-align: 1px; }
:is(.mo, .mo-sheet-back) .mo-soldout { display: inline-block; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #991b1b; }
/* The column sticks, not the basket: the column is a grid item as tall as
   the menu, so it has room to move; the basket inside it did not. */
.mo .mo-basket-col { position: sticky; top: calc(var(--mo-offset, 0px) + 16px); align-self: start; }
:is(.mo, .mo-sheet-back) .mo-basket { border: 1px solid var(--c-border, #e5e7eb); border-radius: var(--r-md, 8px); padding: 16px; max-height: calc(100vh - var(--mo-offset, 0px) - 32px); overflow-y: auto; }
.mo.mo--static-basket .mo-basket-col { position: static; }
.mo.mo--static-basket .mo-basket { max-height: none; overflow: visible; }
:is(.mo, .mo-sheet-back) :is(.mo-basket, .mo-sheet.mo-basket-sheet) { background: var(--mo-basket-bg, var(--c-surface, #fff)); color: var(--mo-basket-fg, inherit); }
.mo-sheet.mo-basket-sheet { background: var(--mo-basket-bg, var(--c-bg, #fff)); }
:is(.mo, .mo-sheet-back) .mo-fg .mo-muted { color: inherit; opacity: .75; }
:is(.mo, .mo-sheet-back) .mo-fg :is(.mo-line, .mo-qty button) { border-color: currentColor; }
/* On a coloured basket the buttons swap to the basket's own colours, so a
   primary-coloured basket doesn't hide its primary Checkout button. */
:is(.mo, .mo-sheet-back) .mo-fg .mo-btn:not(.mo-btn-ghost) { background: var(--mo-basket-fg); color: var(--mo-basket-bg, #fff); }
:is(.mo, .mo-sheet-back) .mo-fg .mo-btn-ghost { color: inherit; border-color: currentColor; }
:is(.mo, .mo-sheet-back) .mo-line { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--c-border, #e5e7eb); }
:is(.mo, .mo-sheet-back) .mo-line:last-child { border-bottom: 0; }
:is(.mo, .mo-sheet-back) .mo-line-opts { font-size: .85rem; color: var(--c-muted, #6b7280); }
:is(.mo, .mo-sheet-back) .mo-qty { display: inline-flex; align-items: center; gap: 4px; }
:is(.mo, .mo-sheet-back) .mo-qty button { width: 36px; height: 36px; border-radius: 999px; border: 1px solid var(--c-border, #e5e7eb); background: transparent; color: inherit; }
:is(.mo, .mo-sheet-back) .mo-row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
:is(.mo, .mo-sheet-back) .mo-total { font-weight: 700; font-size: 1.1rem; }
/* Promotions (migration 131) */
:is(.mo, .mo-sheet-back) .mo-disc { color: #047857; align-items: center; }
:is(.mo, .mo-sheet-back) .mo-fg .mo-disc { color: inherit; }
:is(.mo, .mo-sheet-back) .mo-disc button { border: 0; background: transparent; color: inherit; min-width: 32px; min-height: 32px; font-size: 1.1rem; line-height: 1; padding: 0 4px; }
:is(.mo, .mo-sheet-back) .mo-offer { display: flex; align-items: center; gap: 10px; padding: 10px 12px; margin-top: 10px; border: 1px dashed var(--c-primary, #630812); border-radius: var(--r-md, 8px); }
:is(.mo, .mo-sheet-back) .mo-offer .mo-btn { min-height: 40px; padding: 0 14px; }
:is(.mo, .mo-sheet-back) .mo-hint { font-size: .88rem; margin: 6px 0 0; }
:is(.mo, .mo-sheet-back) .mo-code { margin-top: 10px; }
:is(.mo, .mo-sheet-back) .mo-hint-row { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
:is(.mo, .mo-sheet-back) .mo-hint-row .mo-hint { flex: 1; margin: 0; }
:is(.mo, .mo-sheet-back) .mo-hint-btn { min-height: 40px; padding: 0 14px; flex: none; }
:is(.mo, .mo-sheet-back) .mo-code-row { display: flex; gap: 8px; }
:is(.mo, .mo-sheet-back) .mo-code-row input { flex: 1; min-width: 0; min-height: 44px; padding: 0 12px; border: 1px solid var(--c-border, #d1d5db); border-radius: var(--r-md, 8px); font: inherit; text-transform: uppercase; background: #fff; color: #111827; }
:is(.mo, .mo-sheet-back) .mo-code-row .mo-btn { min-height: 44px; padding: 0 16px; }
:is(.mo, .mo-sheet-back) .mo-link { border: 0; background: transparent; color: inherit; text-decoration: underline; text-underline-offset: 2px; padding: 0; min-height: 40px; }
:is(.mo, .mo-sheet-back) .mo-chip { display: inline-flex; align-items: center; gap: 4px; padding: 2px 4px 2px 10px; margin: 6px 6px 0 0; border-radius: 999px; border: 1px solid currentColor; font-size: .85rem; font-weight: 600; letter-spacing: .03em; }
:is(.mo, .mo-sheet-back) .mo-chip button { border: 0; background: transparent; color: inherit; width: 28px; height: 28px; font-size: 1rem; line-height: 1; }
:is(.mo, .mo-sheet-back) .mo-promo-badge { display: inline-block; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 8px; margin: 0 4px 4px 0; border-radius: 999px; background: var(--c-primary, #630812); color: #fff; }
:is(.mo, .mo-sheet-back) .mo-fav + .mo-promo-badge, :is(.mo, .mo-sheet-back) .mo-promo-badge + .mo-promo-badge { margin-left: 8px; }
.mo .mo-offers { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 4px; }
.mo .mo-offers > div { padding: 8px 12px; border-radius: var(--r-md, 8px); background: var(--c-surface, #fff); border: 1px solid var(--c-border, #e5e7eb); font-size: .9rem; }
.mo .mo-offers strong { color: var(--c-primary, #630812); }
:is(.mo, .mo-sheet-back) .mo-bar { display: none; }
:is(.mo, .mo-sheet-back) .mo-field { display: block; margin-bottom: 14px; }
:is(.mo, .mo-sheet-back) .mo-field span { display: block; font-size: .9rem; font-weight: 600; margin-bottom: 6px; }
:is(.mo, .mo-sheet-back) .mo-field input, :is(.mo, .mo-sheet-back) .mo-field textarea { width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--c-border, #d1d5db); border-radius: var(--r-md, 8px); font: inherit; background: #fff; color: #111827; }
:is(.mo, .mo-sheet-back) .mo-field textarea { min-height: 72px; }
:is(.mo, .mo-sheet-back) .mo-choice { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 8px 12px; border: 1px solid var(--c-border, #e5e7eb); border-radius: var(--r-md, 8px); margin-bottom: 8px; cursor: pointer; }
:is(.mo, .mo-sheet-back) .mo-choice input { width: 20px; height: 20px; }
:is(.mo, .mo-sheet-back) .mo-choice.is-on { border-color: var(--c-primary, #630812); }
.mo .mo-consent { align-items: flex-start; }
.mo .mo-consent input { margin-top: 2px; flex-shrink: 0; }
:is(.mo, .mo-sheet-back) .mo-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(88px, 100%), 1fr)); gap: 8px; }
:is(.mo, .mo-sheet-back) .mo-slot { min-height: 48px; border-radius: var(--r-md, 8px); border: 1px solid var(--c-border, #e5e7eb); background: var(--c-surface, #fff); color: inherit; }
:is(.mo, .mo-sheet-back) .mo-slot.is-on { background: var(--c-primary, #630812); color: #fff; border-color: transparent; }
:is(.mo, .mo-sheet-back) .mo-slot[disabled] { opacity: .4; text-decoration: line-through; cursor: not-allowed; }
:is(.mo, .mo-sheet-back) .mo-panel { border: 1px solid var(--c-border, #e5e7eb); border-radius: var(--r-md, 8px); background: var(--c-surface, #fff); padding: 16px; margin-bottom: 16px; }
.mo-sheet-back { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1000; display: flex; align-items: flex-end; justify-content: center; }
.mo-sheet { background: var(--c-bg, #fff); color: var(--c-text, #1f2937); width: 100%; max-width: 560px; max-height: 88vh; overflow-y: auto; border-radius: 16px 16px 0 0; padding: 20px 16px 16px; font-family: var(--f-body, system-ui), sans-serif; }
.mo-sheet img.mo-hero { width: 100%; max-height: 240px; object-fit: cover; border-radius: 10px; margin-bottom: 12px; }
.mo-sheet h3 { font-family: var(--f-heading, inherit); font-size: 1.35rem; margin: 0 0 6px; }
.mo-sheet .mo-group { margin-top: 18px; }
.mo-sheet .mo-group-head { display: flex; justify-content: space-between; font-weight: 600; margin-bottom: 8px; }
.mo-sheet .mo-sheet-foot { position: sticky; bottom: -16px; background: var(--c-bg, #fff); padding: 12px 0 4px; display: flex; gap: 12px; align-items: center; }
:is(.mo, .mo-sheet-back) .mo-steps { display: flex; gap: 6px; margin: 16px 0; }
:is(.mo, .mo-sheet-back) .mo-step { flex: 1; height: 6px; border-radius: 3px; background: var(--c-border, #e5e7eb); }
:is(.mo, .mo-sheet-back) .mo-step.is-on { background: var(--c-primary, #630812); }
:is(.mo, .mo-sheet-back) .mo-locs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 16px; }
:is(.mo, .mo-sheet-back) .mo-loc { display: block; padding: 20px; border: 1px solid var(--c-border, #e5e7eb); border-radius: var(--r-md, 8px); text-decoration: none; color: inherit; background: var(--c-surface, #fff); }
@media (min-width: 700px) { .mo-sheet-back { align-items: center; } .mo-sheet { border-radius: 16px; } }
/* Basket as a pop-up only (option): the menu takes the full width and the
   basket bar floats at the bottom on every screen size. */
.mo.mo--modal-basket .mo-layout { grid-template-columns: minmax(0, 1fr); }
.mo.mo--modal-basket .mo-basket-col { display: none; }
@media (min-width: 901px) {
  .mo.mo--modal-basket .mo-bar { display: flex; position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); width: min(480px, calc(100% - 24px)); z-index: 50; }
  .mo.mo--modal-basket .mo-bar .mo-btn { width: 100%; justify-content: space-between; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
}
@media (max-width: 900px) {
  :is(.mo, .mo-sheet-back) .mo-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
  /* Tabs run edge to edge on a phone so it is obvious they scroll. */
  :is(.mo, .mo-sheet-back) .mo-tabs { margin: 0 -16px; padding: 8px 16px; max-width: none; scroll-padding-inline: 16px; }
  .mo .mo-navrow .mo-tabs { padding-left: 74px; scroll-padding-inline: 74px 16px; }
  /* The tab strip runs to the screen edge: cover the margin left of the icon too. */
  .mo .mo-navrow::before { left: -16px; width: 64px; }
  .mo .mo-nav { margin: 0 -16px; padding: 4px 16px; }
  :is(.mo, .mo-sheet-back) .mo-basket-col { display: none; }
  :is(.mo, .mo-sheet-back) .mo-bar { display: flex; position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 50; }
  :is(.mo, .mo-sheet-back) .mo-bar .mo-btn { width: 100%; justify-content: space-between; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
}
</style>

<div class="<%= rootClass %>" id="mo-root">
<% if (view === 'pick') { %>
  <% if (!it.orderHideTitle) { %><h1>Order online</h1><% } %>
  <p class="mo-muted" style="margin-bottom: 24px;">Choose where you'd like to collect from.</p>
  <div class="mo-locs">
    <% const pickVenues = it.orderVenues || [] %>
    <% pickVenues.forEach(function (v) { %>
      <% const addr = [v.address_line1, v.city].filter(Boolean).join(', ') %>
      <a class="mo-loc" href="/locations/<%= v.slug %>/order">
        <div style="font-size: 1.1rem; font-weight: 600;"><%= v.name %></div>
        <% if (addr) { %><div class="mo-muted" style="margin-top: 4px;"><%= addr %></div><% } %>
        <div style="margin-top: 12px; color: var(--c-primary); font-weight: 600;">Order for collection &rsaquo;</div>
      </a>
    <% }) %>
  </div>
<% } else { %>
  <div id="mo-app"><p class="mo-muted">Loading&hellip;</p></div>
<% } %>
</div>

<% if (view !== 'pick') { %>
<script type="application/json" id="mo-config"><%~ cfgJson %></script>
<script type="module">
import { optionPriceText, priceLine, priceBasket, formatPence } from '/order-api/pricing.js'
import { venueNow, noticeText, promoSummary, covers, coversIds, isLiveAt } from '/order-api/promotions.js'

const CFG = JSON.parse(document.getElementById('mo-config').textContent)
const OPT = CFG.opts || {}
const API = '/order-api'
const root = document.getElementById('mo-app')

// Space above the sticky category bar and basket. The block's "space for a
// sticky site header" setting wins when set; at 0 we measure whatever site
// header stays at the top of the screen (the header block, a template's
// sticky nav) and sit below it, re-measuring when it changes size.
let headerOffset = OPT.stickyOffset || 0
function findTopBars() {
  const box = document.getElementById('mo-root')
  const seen = new Set()
  const bars = []
  for (const el of document.querySelectorAll('header, nav, .mc-header, body > *, body > * > *')) {
    if (seen.has(el) || !box || box.contains(el) || el.contains(box)) continue
    seen.add(el)
    const cs = getComputedStyle(el)
    if (cs.position !== 'sticky' && cs.position !== 'fixed') continue
    if (cs.display === 'none' || cs.visibility === 'hidden') continue
    const top = parseFloat(cs.top)
    if (!(top >= 0 && top <= 8)) continue
    if (el.offsetWidth < window.innerWidth * 0.5 || !el.offsetHeight || el.offsetHeight > window.innerHeight * 0.4) continue
    bars.push(el)
  }
  return bars
}
let topBars = []
function measureHeader() {
  if (OPT.stickyOffset) return
  const h = topBars.reduce((m, el) => Math.max(m, Math.round(parseFloat(getComputedStyle(el).top) || 0) + el.offsetHeight), 0)
  if (h === headerOffset) return
  headerOffset = h
  document.getElementById('mo-root')?.style.setProperty('--mo-offset', h + 'px')
}
if (!OPT.stickyOffset) {
  topBars = findTopBars()
  measureHeader()
  if (window.ResizeObserver) {
    const ro = new ResizeObserver(measureHeader)
    topBars.forEach(el => ro.observe(el))
  }
  window.addEventListener('resize', () => { topBars = findTopBars(); measureHeader() })
}
// Scroll to the top of the ordering app, not the page: it may sit below
// other blocks (a hero, some text) on the ordering page.
function toAppTop(smooth) {
  const box = document.getElementById('mo-root')
  const y = box ? Math.max(0, box.getBoundingClientRect().top + window.scrollY - 8) : 0
  window.scrollTo({ top: y, behavior: smooth ? 'smooth' : 'auto' })
}

const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')

async function api(path, opts = {}) {
  const res = await fetch(API + path, {
    method: opts.method || 'GET',
    headers: opts.body ? { 'Content-Type': 'application/json' } : {},
    body: opts.body ? JSON.stringify(opts.body) : undefined,
  })
  let data = null
  try { data = await res.json() } catch {}
  if (!res.ok) {
    const err = new Error((data && (data.error || data.message)) || ('Something went wrong (' + res.status + ')'))
    err.data = data
    throw err
  }
  return data
}

function fmtTime(iso, tz) {
  return new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(iso))
}
function fmtDay(dateStr, today) {
  if (dateStr === today) return 'Today'
  const d = new Date(dateStr + 'T12:00:00Z')
  return new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }).format(d)
}

if (CFG.view === 'status') startStatus()
else startOrdering()

// ════════════════════════════════════════════════════════════
//  Ordering
// ════════════════════════════════════════════════════════════

async function startOrdering() {
  let data
  try {
    data = await api('/venues/' + CFG.venueId)
  } catch (e) {
    root.innerHTML = '<div class="mo-error">' + esc(e.message) + '</div>'
    return
  }
  const venue = data.venue
  const ord = data.ordering
  const cur = venue.currency || 'GBP'
  const money = p => formatPence(p, cur)
  const tags = Object.fromEntries((data.dietary_tags || []).map(t => [t.code, t]))
  const itemsById = {}
  for (const m of data.menus) for (const s of m.sections) for (const i of s.items) itemsById[i.id] = i

  const KEY = 'maca_basket_' + venue.id
  // Start on the first menu that is on now (menu schedules, migration 130).
  const firstOn = Math.max(0, data.menus.findIndex(m => m.on_now !== false))
  const state = {
    menuIdx: firstOn,
    basket: loadBasket(),
    step: 'menu',          // menu | checkout | pay
    when: null,            // 'asap' | slot ISO
    date: ord.dates[0],
    slots: null,
    tip: 0,
    method: (ord.payment_methods[0] || {}).key || null,
    form: { name: '', email: '', phone: '', allergy_note: '', notes: '', data_consent: false, marketing_opt_in: false },
    error: null,
    busy: false,
    pay: null,             // { token, payment }
    q: '',                 // dish search (option)
    searchOpen: false,     // search shown as an icon and opened (option)
    // Promotions (migration 131): manual offers the guest applied, and code
    // promotions opened by a typed code (the code only reaches the page then).
    chosen: [],
    unlocked: [],
    codeOpen: false,
    codeBusy: false,
    codeError: null,
  }
  const PROMO_KEY = 'maca_promos_' + venue.id
  try {
    const saved = JSON.parse(localStorage.getItem(PROMO_KEY) || '{}')
    if (Array.isArray(saved.chosen)) state.chosen = saved.chosen.filter(id => typeof id === 'string')
    state.savedCodes = Array.isArray(saved.codes) ? saved.codes.filter(c => typeof c === 'string').slice(0, 5) : []
  } catch { state.savedCodes = [] }

  function loadBasket() {
    try {
      const b = JSON.parse(localStorage.getItem(KEY) || '[]')
      return Array.isArray(b) ? b.filter(l => itemsById[l.item_id]) : []
    } catch { return [] }
  }
  function saveBasket() {
    try { localStorage.setItem(KEY, JSON.stringify(state.basket)) } catch {}
  }
  function savePromos() {
    try { localStorage.setItem(PROMO_KEY, JSON.stringify({ chosen: state.chosen, codes: state.unlocked.map(p => p.code) })) } catch {}
  }
  function promosInPlay() { return [...(data.promotions || []), ...state.unlocked] }
  function promoCtx() {
    return { at: venueNow(venue.timezone), venueId: venue.id, chosen: state.chosen, unlocked: state.unlocked.map(p => p.id) }
  }
  function quote() {
    return priceBasket(itemsById, state.basket, { tipPercent: state.tip, promos: promosInPlay(), promoCtx: promoCtx() })
  }
  const BADGE_KINDS = new Set(['item', 'bogo', 'free_item', 'bundle'])
  // Take the guest to a dish a promotion needs: the dish itself when there
  // is only one, otherwise the first of them on the menu.
  function promoDishes(p, part) {
    const c = p.kind === 'bundle' ? (p.bundle || [])[part] || {} : p
    const out = []
    data.menus.forEach((m, mi) => {
      for (const s of m.sections) for (const i of s.items) {
        if (!i.sold_out && coversIds(c.item_ids, c.section_ids, { item_id: i.id, section_id: i.section_id })) out.push({ item: i, menuIdx: mi, sectionId: s.id })
      }
    })
    return out
  }
  function showPromoDish(promoId, part) {
    const p = promosInPlay().find(x => x.id === promoId)
    const dishes = p ? promoDishes(p, Number(part) || 0) : []
    if (!dishes.length) return
    if (dishes.length === 1) return openItem(dishes[0].item)
    state.q = ''
    if (state.menuIdx !== dishes[0].menuIdx) { state.menuIdx = dishes[0].menuIdx; draw() }
    jumpTo(dishes[0].sectionId)
  }
  // Labels on the dishes an offer covers (item and buy X get Y offers that
  // are on now and that the guest has, or can get without a code).
  function promoBadges(i) {
    const at = venueNow(venue.timezone)
    return promosInPlay().filter(p => p.badge_text && BADGE_KINDS.has(p.kind) && isLiveAt(p, { at, venueId: venue.id }) &&
      covers(p, { item_id: i.id, section_id: i.section_id }))
      .map(p => '<span class="mo-promo-badge">' + esc(p.badge_text) + '</span>').join('')
  }

  async function checkCode(code) {
    const r = await api('/venues/' + venue.id + '/promo-code', { method: 'POST', body: { code } })
    const p = r.promotion
    state.unlocked = state.unlocked.filter(x => x.id !== p.id).concat(p)
    return p
  }
  async function applyCode(code, rerender) {
    code = String(code || '').trim()
    if (!code || state.codeBusy) return
    state.codeBusy = true
    state.codeError = null
    rerender()
    try {
      await checkCode(code)
      state.codeOpen = false
      savePromos()
    } catch (e) {
      state.codeError = e.message
      state.codeText = code
    }
    state.codeBusy = false
    rerender()
  }
  // Codes and offers can run out or be switched off: check them again
  // (on load, and when the server refuses one at checkout).
  async function refreshPromos(codes) {
    try {
      const fresh = await api('/venues/' + CFG.venueId)
      data.promotions = fresh.promotions || []
      data.has_promo_codes = fresh.has_promo_codes
    } catch {}
    state.unlocked = []
    for (const c of codes) { try { await checkCode(c) } catch {} }
    const ids = new Set((data.promotions || []).map(p => p.id))
    state.chosen = state.chosen.filter(id => ids.has(id))
    savePromos()
  }
  function promoClick(t, rerender) {
    const d = t.dataset
    if (d.offer) { if (!state.chosen.includes(d.offer)) state.chosen = [...state.chosen, d.offer]; savePromos(); rerender(); return true }
    if (d.unoffer) { state.chosen = state.chosen.filter(x => x !== d.unoffer); savePromos(); rerender(); return true }
    if (d.promoDish) { showPromoDish(d.promoDish, d.part); return true }
    if (d.uncode) { state.unlocked = state.unlocked.filter(p => p.id !== d.uncode); savePromos(); rerender(); return true }
    if ('codeOpen' in d) {
      state.codeOpen = true
      state.codeError = null
      rerender()
      ;[...document.querySelectorAll('[data-code-input]')].find(el => el.offsetParent)?.focus()
      return true
    }
    if ('codeApply' in d) {
      applyCode(t.closest('.mo-code')?.querySelector('[data-code-input]')?.value, rerender)
      return true
    }
    return false
  }
  function promoKey(e, rerender) {
    if (e.key === 'Enter' && 'codeInput' in e.target.dataset) { e.preventDefault(); applyCode(e.target.value, rerender) }
  }

  function tagHtml(codes) {
    return (codes || []).map(c => tags[c] ? '<span class="mo-tag" title="' + esc(tags[c].label) + '" style="background:' + esc(tags[c].colour) + '">' + esc(tags[c].glyph) + '</span>' : '').join('')
  }

  // ── Menu ──
  const STAR = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.5l7.1-.6z"/></svg>'
  const fav = i => !!(OPT.favourites && i.featured)
  function favBadge() { return '<div class="mo-fav">' + STAR + esc(OPT.favouriteLabel || 'House favourite') + '</div>' }

  // How many of a dish are in the basket, over all its lines (different
  // options or notes are separate lines).
  const BAG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>'
  const inBasket = id => state.basket.reduce((n, l) => n + (l.item_id === id ? l.qty : 0), 0)

  // Minimum order quantity (menu_items.min_order_qty, migration 133): counts
  // every line of the dish; priceBasket() rejects a basket below it.
  const minQty = item => (Number(item && item.min_qty) > 1 ? Number(item.min_qty) : 1)
  const minHtml = item => (minQty(item) > 1 ? '<span class="mo-min" title="Minimum order">Min ' + minQty(item) + '</span>' : '')
  function itemCardHtml(i) {
    const price = i.from_pence == null ? '' : ((i.choices.some(c => c.mode === 'base' && c.options.length > 1) ? 'from ' : '') + money(i.from_pence))
    const n = inBasket(i.id)
    return '<button class="mo-item' + (i.sold_out ? ' is-out' : '') + (fav(i) ? ' is-fav' : '') + (n ? ' is-in' : '') + '" data-item="' + esc(i.id) + '"' + (i.sold_out ? ' disabled' : '') + '>' +
      (n ? '<span class="mo-in-basket" aria-label="' + n + ' in your basket">' + BAG + n + '</span>' : '') +
      '<div class="mo-item-body">' + (fav(i) ? favBadge() : '') + promoBadges(i) + '<div class="mo-item-name">' + esc(i.name) + '</div>' +
      (i.description ? '<div class="mo-item-desc">' + esc(i.description) + '</div>' : '') +
      '<div class="mo-item-price">' + (i.sold_out ? '<span class="mo-soldout">Sold out</span>' : esc(price) + minHtml(i)) + ' ' + tagHtml(i.dietary) + '</div></div>' +
      (i.image_url ? '<img src="' + esc(i.image_url) + '" alt="" loading="lazy">' : '') +
      '</button>'
  }

  // Search, menu tabs and category tabs: one bar, sticky when the block
  // says so. While searching the tabs are hidden (results span all menus).
  function tabsHtml() {
    const menus = data.menus
    if (state.q) return ''
    const m = menus[state.menuIdx] || menus[0]
    let h = ''
    if (menus.length > 1) {
      h += '<div class="mo-tabs">' + menus.map((x, i) => '<button class="mo-tab' + (i === state.menuIdx ? ' is-on' : '') + '" data-menu="' + i + '">' + esc(x.name) + '</button>').join('') + '</div>'
    }
    if (m.sections.length > 1) {
      h += '<div class="mo-tabs">' + m.sections.map(s => '<button class="mo-tab" data-jump="' + esc(s.id) + '">' + esc(s.title) + '</button>').join('') + '</div>'
    }
    return h
  }
  // Search as a round icon beside the categories: always, or only on
  // phones (the width where the basket becomes a pop-up).
  const SEARCH_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>'
  const phoneMq = window.matchMedia('(max-width: 900px)')
  const searchAsIcon = () => !!OPT.search && (OPT.searchStyle === 'icon' || (OPT.searchStyle === 'icon_phone' && phoneMq.matches))
  function navHtml() {
    let h = '<div class="mo-nav">'
    if (searchAsIcon()) {
      if (state.searchOpen || state.q) {
        h += '<div class="mo-search mo-search--open">' + SEARCH_SVG +
          '<input type="search" data-search placeholder="Search dishes" aria-label="Search dishes" autocomplete="off" value="' + esc(state.q) + '">' +
          '<button type="button" data-close-search aria-label="Close search">&times;</button></div>'
      } else {
        h += '<div class="mo-navrow"><button type="button" class="mo-search-btn" data-open-search aria-label="Search dishes">' + SEARCH_SVG + '</button>' +
          '<div id="mo-nav-tabs">' + tabsHtml() + '</div></div>'
      }
      return h + '</div>'
    }
    if (OPT.search) {
      h += '<div class="mo-search"><input type="search" data-search placeholder="Search dishes" aria-label="Search dishes" autocomplete="off" value="' + esc(state.q) + '">' +
        '<button type="button" data-clear-search aria-label="Clear search">&times;</button></div>'
    }
    h += '<div id="mo-nav-tabs">' + tabsHtml() + '</div></div>'
    return h
  }

  const norm = t => String(t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
  function searchResultsHtml() {
    const q = norm(state.q.trim())
    let h = ''
    let found = 0
    for (const m of data.menus) {
      for (const s of m.sections) {
        const hits = s.items.filter(i => norm([i.name, i.native_name, i.description].filter(Boolean).join(' ')).includes(q))
        if (!hits.length) continue
        found += hits.length
        h += '<h2>' + esc(data.menus.length > 1 ? m.name + ' · ' + s.title : s.title) + '</h2><div class="mo-items">' + hits.map(itemCardHtml).join('') + '</div>'
      }
    }
    return found ? h : '<p class="mo-muted" style="margin-top:16px;">No dishes match &ldquo;' + esc(state.q.trim()) + '&rdquo;.</p>'
  }

  function menuBodyHtml() {
    if (state.q.trim()) return searchResultsHtml()
    const m = data.menus[state.menuIdx] || data.menus[0]
    let h = ''
    if (m.schedule) {
      h += '<p class="mo-muted" style="margin:8px 0 12px;">' + esc(m.name) + ' is available ' + esc(m.schedule) +
        (m.on_now === false ? '. It isn\'t on right now: you can still order it for a time when it is.' : '.') + '</p>'
    }
    for (const s of m.sections) {
      h += '<h2 id="sec-' + esc(s.id) + '">' + esc(s.title) + '</h2>'
      if (s.subtitle) h += '<p class="mo-muted" style="margin:-6px 0 12px;">' + esc(s.subtitle) + '</p>'
      h += '<div class="mo-items">' + s.items.map(itemCardHtml).join('') + '</div>'
    }
    return h
  }

  function menuHtml() {
    const menus = data.menus
    if (!menus.length) return '<div class="mo-banner">There is nothing to order right now.</div>'
    let h = navHtml() + '<div id="mo-menu-body">' + menuBodyHtml() + '</div>'
    const usedTags = new Set()
    for (const x of menus) for (const s of x.sections) for (const i of s.items) for (const c of i.dietary || []) usedTags.add(c)
    if (usedTags.size) {
      h += '<p class="mo-muted" style="margin-top:24px;font-size:.9rem;">' + [...usedTags].filter(c => tags[c]).map(c => tagHtml([c]) + esc(tags[c].label)).join(' &nbsp; ') + '</p>'
    }
    h += '<p class="mo-muted" style="font-size:.9rem;">Allergies or dietary needs? Tell us in the allergy note at checkout' + (venue.phone ? ', or call us on ' + esc(venue.phone) : '') + ' before you order.</p>'
    return h
  }

  // Jump to a category below the sticky bar, and keep the current
  // category's tab lit while scrolling.
  function barBottom() {
    const nav = root.querySelector('.mo-nav')
    return OPT.stickyNav && nav ? headerOffset + nav.offsetHeight : headerOffset
  }
  function jumpTo(id) {
    const el = document.getElementById('sec-' + id)
    if (!el) return
    window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - barBottom() - 8, behavior: 'smooth' })
  }
  function spy() {
    if (state.step !== 'menu' || state.q.trim()) return
    const tabs = [...root.querySelectorAll('[data-jump]')]
    if (!tabs.length) return
    const line = barBottom() + 16
    let current = tabs[0].dataset.jump
    for (const t of tabs) {
      const el = document.getElementById('sec-' + t.dataset.jump)
      if (el && el.getBoundingClientRect().top <= line) current = t.dataset.jump
    }
    for (const t of tabs) {
      const on = t.dataset.jump === current
      if (on === t.classList.contains('is-on')) continue
      t.classList.toggle('is-on', on)
      if (on) {
        const strip = t.parentElement
        const sr = strip.getBoundingClientRect()
        const tr = t.getBoundingClientRect()
        strip.scrollTo({ left: strip.scrollLeft + (tr.left - sr.left) - sr.width / 2 + tr.width / 2, behavior: 'smooth' })
      }
    }
  }
  let spyFrame = 0
  window.addEventListener('scroll', () => {
    if (spyFrame) return
    spyFrame = requestAnimationFrame(() => { spyFrame = 0; spy() })
  }, { passive: true })

  // ── Basket ──
  function basketHtml(compact) {
    const q = quote()
    if (!state.basket.length) return '<p class="mo-muted">Your basket is empty.</p>'
    let h = ''
    q.lines.forEach((l, idx) => {
      h += '<div class="mo-line"><div style="flex:1;min-width:0;"><div><strong>' + esc(l.name) + '</strong></div>' +
        (l.options.length ? '<div class="mo-line-opts">' + esc(l.options.map(o => o.label).join(', ')) + '</div>' : '') +
        (l.note ? '<div class="mo-line-opts">Note: ' + esc(l.note) + '</div>' : '') +
        '<div class="mo-qty" style="margin-top:6px;"><button data-dec="' + idx + '" aria-label="One less">&minus;</button><span style="min-width:24px;text-align:center;">' + l.qty + '</span><button data-inc="' + idx + '" aria-label="One more">+</button></div>' +
        '</div><div style="white-space:nowrap;">' + money(l.line_total_pence) + '</div></div>'
    })
    if (q.errors.length) h += '<div class="mo-error">' + esc(q.errors[0].error) + '</div>'
    h += '<div class="mo-row' + (q.discount_pence ? '' : ' mo-total') + '" style="margin-top:8px;"><span>Subtotal</span><span>' + money(q.subtotal_pence) + '</span></div>'
    h += promoRowsHtml(q)
    if (q.discount_pence && !compact) h += '<div class="mo-row mo-total"><span>Total</span><span>' + money(q.subtotal_pence - q.discount_pence) + '</span></div>'
    // At checkout the VAT line goes under the Total instead.
    if (!compact && OPT.showVat && q.vat_pence) h += '<div class="mo-row mo-muted" style="font-size:.9rem;"><span>Includes VAT</span><span>' + money(q.vat_pence) + '</span></div>'
    h += promoExtrasHtml(q)
    if (ord.min_order_pence && q.subtotal_pence < ord.min_order_pence) {
      h += '<p class="mo-muted" style="font-size:.9rem;">Minimum order ' + money(ord.min_order_pence) + '</p>'
    }
    if (!compact) {
      h += '<button class="mo-btn mo-btn-block" data-checkout style="margin-top:12px;"' + (canCheckout(q) ? '' : ' disabled') + '>Checkout</button>'
    }
    return h
  }
  // Discount lines: one per promotion taken off. Offers the guest applied or
  // opened with a code can be removed again.
  function promoRowsHtml(q) {
    return q.promotions.map(p => {
      const code = state.unlocked.find(x => x.id === p.id)
      const rm = code ? ' data-uncode="' + esc(p.id) + '"' : state.chosen.includes(p.id) ? ' data-unoffer="' + esc(p.id) + '"' : ''
      return '<div class="mo-row mo-disc"><span>' + esc(p.name) + (p.code ? ' (' + esc(p.code) + ')' : '') +
        (rm ? ' <button type="button"' + rm + ' aria-label="Remove ' + esc(p.name) + '">&times;</button>' : '') +
        '</span><span>&minus;' + money(p.discount_pence) + '</span></div>'
    }).join('')
  }
  // Offers to tap, what's missing for an offer, and the promo code box.
  function promoExtrasHtml(q) {
    let h = ''
    for (const o of q.promo_offers) {
      h += '<div class="mo-offer"><div style="flex:1;min-width:0;"><strong>' + esc(o.name) + '</strong>' +
        '<div class="mo-muted" style="font-size:.88rem;">' + (o.description ? esc(o.description) + ' · ' : '') + 'Save ' + money(o.saving_pence) + '</div></div>' +
        '<button type="button" class="mo-btn" data-offer="' + esc(o.id) + '">Apply</button></div>'
    }
    for (const n of q.promo_notices) {
      const t = noticeText(n, money)
      if (!t) continue
      // Free dish / meal deal: a button that takes the guest to the dish.
      let btn = ''
      if (n.reason === 'free_item_missing') btn = '<button type="button" class="mo-btn mo-btn-ghost mo-hint-btn" data-promo-dish="' + esc(n.id) + '">Choose</button>'
      if (n.reason === 'bundle_missing' && n.missing && n.missing[0]) btn = '<button type="button" class="mo-btn mo-btn-ghost mo-hint-btn" data-promo-dish="' + esc(n.id) + '" data-part="' + n.missing[0].index + '">Add ' + esc(n.missing[0].label) + '</button>'
      h += btn ? '<div class="mo-hint-row"><p class="mo-muted mo-hint">' + esc(t) + '</p>' + btn + '</div>' : '<p class="mo-muted mo-hint">' + esc(t) + '</p>'
    }
    if (data.has_promo_codes || state.unlocked.length) {
      h += '<div class="mo-code">'
      const applied = new Set(q.promotions.map(p => p.id))
      for (const p of state.unlocked) {
        if (applied.has(p.id)) continue
        h += '<span class="mo-chip">' + esc(p.code) + '<button type="button" data-uncode="' + esc(p.id) + '" aria-label="Remove code ' + esc(p.code) + '">&times;</button></span>'
      }
      if (state.codeOpen) {
        h += '<div class="mo-code-row" style="margin-top:6px;"><input data-code-input placeholder="Promo code" aria-label="Promo code" autocomplete="off" autocapitalize="characters" maxlength="40" value="' + esc(state.codeText || '') + '">' +
          '<button type="button" class="mo-btn" data-code-apply' + (state.codeBusy ? ' disabled' : '') + '>' + (state.codeBusy ? '&hellip;' : 'Apply') + '</button></div>'
        if (state.codeError) h += '<p class="mo-hint" style="color:#b91c1c;">' + esc(state.codeError) + '</p>'
      } else if (data.has_promo_codes) {
        h += '<div><button type="button" class="mo-link mo-muted" data-code-open>Have a promo code?</button></div>'
      }
      h += '</div>'
    }
    return h
  }
  function canCheckout(q) {
    return !ord.is_paused && q.lines.length && !q.errors.length && q.subtotal_pence >= (ord.min_order_pence || 0)
  }

  // ── Dish sheet ──
  function openItem(item) {
    const choices = item.choices
    // Start at what's still needed to reach the dish's minimum.
    const floorQty = Math.max(1, minQty(item) - inBasket(item.id))
    const sel = { choices: {}, qty: floorQty, note: '' }
    for (const c of choices) {
      sel.choices[c.key] = (c.min === 1 && c.max === 1 && c.options.length === 1) ? [c.options[0].id] : []
    }
    const back = document.createElement('div')
    back.className = 'mo-sheet-back'
    document.body.appendChild(back)
    const close = () => { back.remove(); document.body.style.overflow = '' }
    document.body.style.overflow = 'hidden'
    back.addEventListener('click', e => { if (e.target === back) close() })

    function render() {
      const priced = priceLine(item, sel, choices)
      let h = '<div class="mo-sheet" role="dialog" aria-modal="true">'
      if (item.image_url) h += '<img class="mo-hero" src="' + esc(item.image_url) + '" alt="">'
      if (fav(item)) h += favBadge()
      h += '<h3>' + esc(item.name) + '</h3>'
      if (item.description) h += '<p class="mo-muted" style="margin:0 0 6px;">' + esc(item.description) + '</p>'
      if (item.dietary && item.dietary.length) h += '<div>' + tagHtml(item.dietary) + '</div>'
      if (item.calories) h += '<p class="mo-muted" style="font-size:.85rem;">' + esc(item.calories) + ' kcal</p>'
      if (minQty(item) > 1) h += '<p class="mo-muted" style="font-size:.9rem;font-weight:600;">Minimum order: ' + minQty(item) + (inBasket(item.id) ? ' (you have ' + inBasket(item.id) + ')' : '') + '</p>'
      for (const c of choices) {
        const multi = c.max > 1
        const rule = c.min === 0 ? (multi ? 'Optional, up to ' + c.max : 'Optional') : (c.min === c.max ? (c.min === 1 ? 'Choose 1' : 'Choose ' + c.min) : 'Choose ' + c.min + '–' + c.max)
        h += '<div class="mo-group"><div class="mo-group-head"><span>' + esc(c.key === 'variants' ? 'Options' : c.name) + '</span><span class="mo-muted" style="font-weight:400;font-size:.9rem;">' + rule + '</span></div>'
        for (const o of c.options) {
          const on = sel.choices[c.key].includes(o.id)
          const price = optionPriceText(c, o, money)
          h += '<label class="mo-choice' + (on ? ' is-on' : '') + '"><input type="' + (multi ? 'checkbox' : 'radio') + '" name="c-' + esc(c.key) + '" data-c="' + esc(c.key) + '" data-o="' + esc(o.id) + '"' + (on ? ' checked' : '') + '><span style="flex:1;">' + esc(o.label) + '</span><span class="mo-muted">' + esc(price) + '</span></label>'
        }
        h += '</div>'
      }
      if (OPT.itemNotes !== false) h += '<label class="mo-field" style="margin-top:18px;"><span>Note for the kitchen (optional)</span><input data-note maxlength="300" value="' + esc(sel.note) + '" placeholder="e.g. no onion"></label>'
      h += '<div class="mo-sheet-foot"><div class="mo-qty"><button data-q="-1" aria-label="One less">&minus;</button><span style="min-width:28px;text-align:center;font-weight:600;">' + sel.qty + '</span><button data-q="1" aria-label="One more">+</button></div>' +
        '<button class="mo-btn" style="flex:1;" data-add' + (priced.ok ? '' : ' disabled') + '>' + (priced.ok ? 'Add ' + money(priced.unit_pence * sel.qty) : esc(priced.error)) + '</button></div>'
      h += '<button class="mo-btn mo-btn-ghost mo-btn-block" data-close style="margin-top:8px;">Cancel</button></div>'
      back.innerHTML = h
    }
    render()
    back.addEventListener('change', e => {
      const c = e.target.dataset.c
      if (!c) return
      const choice = choices.find(x => x.key === c)
      const o = e.target.dataset.o
      let list = sel.choices[c]
      if (choice.max === 1) list = e.target.checked ? [o] : []
      else if (e.target.checked) { if (list.length < choice.max) list = [...list, o] } else list = list.filter(x => x !== o)
      sel.choices[c] = list
      render()
    })
    back.addEventListener('input', e => { if ('note' in e.target.dataset) sel.note = e.target.value })
    back.addEventListener('click', e => {
      const t = e.target.closest('button')
      if (!t) return
      if ('close' in t.dataset) close()
      else if (t.dataset.q) { sel.qty = Math.max(floorQty, Math.min(99, sel.qty + Number(t.dataset.q))); render() }
      else if ('add' in t.dataset) {
        state.basket.push({ item_id: item.id, qty: sel.qty, choices: sel.choices, note: sel.note.trim() || null })
        saveBasket()
        close()
        draw()
      }
    })
  }

  // ── Checkout ──
  async function loadSlots() {
    state.slots = null
    draw()
    try {
      // The basket's dishes decide which times are offered (menu schedules).
      const items = [...new Set(state.basket.map(l => l.item_id))].join(',')
      state.slots = await api('/venues/' + venue.id + '/slots?date=' + state.date + (items ? '&items=' + encodeURIComponent(items) : ''))
      // A time picked earlier may be gone (e.g. the basket changed).
      const stillOk = state.when === 'asap' ? state.slots.asap.available
        : state.slots.slots.some(s => s.at === state.when && s.available)
      if (!stillOk) state.when = null
      if (!state.when) {
        if (state.slots.asap.available) state.when = 'asap'
        else state.when = (state.slots.slots.find(s => s.available) || {}).at || null
      }
    } catch (e) {
      state.error = e.message
    }
    draw()
  }

  function checkoutHtml() {
    const q = quote()
    const f = state.form
    let h = '<button class="mo-btn mo-btn-ghost" data-back style="margin-bottom:12px;">&larr; Back to menu</button>'
    h += '<h1>Checkout</h1><p class="mo-muted">Collection from ' + esc(venue.name) + (venue.address_line1 ? ', ' + esc(venue.address_line1) : '') + '</p>'
    if (state.error) h += '<div class="mo-error">' + esc(state.error) + '</div>'

    h += '<div class="mo-panel"><h2 style="margin-top:0;">When</h2>'
    if (ord.dates.length > 1) {
      h += '<div class="mo-tabs" style="position:static;">' + ord.dates.map(d => '<button class="mo-tab' + (d === state.date ? ' is-on' : '') + '" data-date="' + d + '">' + esc(fmtDay(d, ord.today)) + '</button>').join('') + '</div>'
    }
    if (!state.slots) h += '<p class="mo-muted">Loading times&hellip;</p>'
    else if (!state.slots.is_open) h += '<p class="mo-muted">We are not taking orders for this day.</p>'
    else {
      if (state.slots.asap.available) {
        h += '<label class="mo-choice' + (state.when === 'asap' ? ' is-on' : '') + '"><input type="radio" name="when" data-when="asap"' + (state.when === 'asap' ? ' checked' : '') + '><span style="flex:1;">As soon as possible</span><span class="mo-muted">ready about ' + fmtTime(state.slots.asap.promised_at, venue.timezone) + '</span></label>'
      }
      const avail = state.slots.slots.filter(s => s.available || s.full)
      if (avail.length) {
        h += '<p class="mo-muted" style="margin:12px 0 8px;">Or choose a time</p><div class="mo-slots">' +
          avail.map(s => '<button class="mo-slot' + (state.when === s.at ? ' is-on' : '') + '" data-slot="' + esc(s.at) + '"' + (s.available ? '' : ' disabled title="Fully booked"') + '>' + esc(s.time) + '</button>').join('') + '</div>'
      } else if (!state.slots.asap.available) {
        h += '<p class="mo-muted">' + (state.slots.off_menu
          ? 'The dishes in your basket are not all served at the same time on this day. Try another day, or remove some to see collection times.'
          : 'No collection times left for this day.') + '</p>'
      }
      if (state.slots.off_menu && (avail.length || state.slots.asap.available)) {
        h += '<p class="mo-muted" style="margin-top:8px;font-size:.9rem;">Some dishes in your basket are only served at certain times, so only those times are shown.</p>'
      }
    }
    h += '</div>'

    h += '<div class="mo-panel"><h2 style="margin-top:0;">Your details</h2>' +
      '<label class="mo-field"><span>Name</span><input data-f="name" autocomplete="name" value="' + esc(f.name) + '" maxlength="120"></label>' +
      '<label class="mo-field"><span>Email</span><input data-f="email" type="email" autocomplete="email" value="' + esc(f.email) + '" maxlength="200"></label>' +
      '<label class="mo-field"><span>Phone</span><input data-f="phone" type="tel" inputmode="tel" autocomplete="tel" value="' + esc(f.phone) + '" maxlength="40"></label>' +
      '<label class="mo-field"><span>Allergies (optional)</span><textarea data-f="allergy_note" maxlength="500" placeholder="Tell us about any allergies">' + esc(f.allergy_note) + '</textarea></label>' +
      '<label class="mo-field"><span>Anything else? (optional)</span><textarea data-f="notes" maxlength="500">' + esc(f.notes) + '</textarea></label>' +
      '</div>'

    // GDPR (migration 125): the wording comes from the server, which
    // records the same text on the order.
    const pv = data.privacy || {}
    h += '<div class="mo-panel"><h2 style="margin-top:0;">Your privacy</h2>' +
      '<label class="mo-choice mo-consent' + (f.data_consent ? ' is-on' : '') + '"><input type="checkbox" data-f="data_consent"' + (f.data_consent ? ' checked' : '') + '><span>' + esc(pv.data_text || '') + ' <span class="mo-muted">(required)</span></span></label>' +
      '<label class="mo-choice mo-consent' + (f.marketing_opt_in ? ' is-on' : '') + '"><input type="checkbox" data-f="marketing_opt_in"' + (f.marketing_opt_in ? ' checked' : '') + '><span>' + esc(pv.marketing_text || '') + '</span></label>' +
      (pv.policy_url ? '<p class="mo-muted" style="font-size:.9rem;margin:4px 0 0;">See our <a href="' + esc(pv.policy_url) + '" target="_blank" rel="noopener">privacy policy</a> for how we look after your data and your rights.</p>' : '') +
      '</div>'

    if (ord.tips_enabled && ord.tip_percents.length) {
      h += '<div class="mo-panel"><h2 style="margin-top:0;">Add a tip?</h2><div class="mo-slots">' +
        [0, ...ord.tip_percents].map(p => '<button class="mo-slot' + (state.tip === p ? ' is-on' : '') + '" data-tip="' + p + '">' + (p ? p + '%' : 'No tip') + '</button>').join('') + '</div></div>'
    }

    h += '<div class="mo-panel"><h2 style="margin-top:0;">Payment</h2>'
    if (!ord.payment_methods.length) h += '<p class="mo-muted">Online ordering is not taking payments right now.</p>'
    for (const m of ord.payment_methods) {
      h += '<label class="mo-choice' + (state.method === m.key ? ' is-on' : '') + '"><input type="radio" name="pm" data-method="' + esc(m.key) + '"' + (state.method === m.key ? ' checked' : '') + '><span>' + esc(m.label) + '</span></label>'
    }
    h += '</div>'

    h += '<div class="mo-panel"><h2 style="margin-top:0;">Your order</h2>' + basketHtml(true)
    if (q.tip_pence) h += '<div class="mo-row"><span>Tip</span><span>' + money(q.tip_pence) + '</span></div>'
    h += '<div class="mo-row mo-total"><span>Total</span><span>' + money(q.total_pence) + '</span></div>'
    if (OPT.showVat && q.vat_pence) h += '<div class="mo-row mo-muted" style="font-size:.9rem;"><span>Includes VAT</span><span>' + money(q.vat_pence) + '</span></div>'
    h += '</div>'

    const m = ord.payment_methods.find(x => x.key === state.method)
    const ready = readyToPlace()
    h += '<button class="mo-btn mo-btn-block" data-place' + (ready && !state.busy ? '' : ' disabled') + '>' +
      (state.busy ? 'Placing order&hellip;' : (m && m.online ? 'Continue to payment' : 'Place order') + ' · ' + money(q.total_pence)) + '</button>'
    if (!ready && !state.busy) h += '<p class="mo-muted" style="font-size:.9rem;margin-top:8px;">Choose a time, fill in your name, email and phone, and agree to how we use your details to continue.</p>'
    return h
  }

  function readyToPlace() {
    const f = state.form
    return !!(canCheckout(quote()) && state.when && f.name.trim() && /.+@.+\..+/.test(f.email.trim()) &&
      f.phone.trim().length >= 5 && f.data_consent && ord.payment_methods.some(x => x.key === state.method))
  }

  async function placeOrder() {
    state.busy = true
    state.error = null
    draw()
    const f = state.form
    try {
      const res = await api('/venues/' + venue.id + '/orders', {
        method: 'POST',
        body: {
          lines: state.basket, when: state.when,
          customer: { name: f.name.trim(), email: f.email.trim(), phone: f.phone.trim() },
          notes: f.notes.trim() || null, allergy_note: f.allergy_note.trim() || null,
          data_consent: !!f.data_consent, marketing_opt_in: !!f.marketing_opt_in, tip_percent: state.tip, payment_method: state.method,
          promo_codes: state.unlocked.map(p => p.code), promo_ids: state.chosen,
        },
      })
      state.basket = []
      saveBasket()
      state.chosen = []
      state.unlocked = []
      savePromos()
      if (res.payment) {
        state.pay = { token: res.token, payment: res.payment }
        state.step = 'pay'
        state.busy = false
        draw()
      } else {
        location.href = CFG.statusBase + res.token
      }
    } catch (e) {
      state.busy = false
      state.error = e.message
      if (e.data && e.data.code === 'slot_unavailable') { state.when = null; loadSlots() }
      if (e.data && e.data.code === 'promo_invalid') await refreshPromos(state.unlocked.map(p => p.code))
      draw()
      toAppTop(true)
    }
  }

  function payHtml() {
    return paymentPanel(state.pay.payment, money, state.error)
  }

  async function pay(outcome) {
    state.busy = true
    draw()
    const res = await runPayment(state.pay.token, state.pay.payment, outcome)
    state.busy = false
    if (res.done) location.href = CFG.statusBase + state.pay.token
    else { state.error = res.error; draw() }
  }

  // Promotions on now that guests can get without a code, under the title.
  function offersStripHtml() {
    const at = venueNow(venue.timezone)
    const live = (data.promotions || []).filter(p => isLiveAt(p, { at, venueId: venue.id }))
    if (!live.length) return ''
    return '<div class="mo-offers">' + live.map(p => '<div><strong>' + esc(p.name) + '</strong> <span class="mo-muted">' +
      esc(promoSummary(p, money) + (p.min_subtotal_pence ? ' when you spend ' + money(p.min_subtotal_pence) : '') +
        (p.apply_mode === 'manual' ? ' · apply it in your basket' : '')) + '</span></div>').join('') + '</div>'
  }

  // ── Draw ──
  function draw() {
    let h = ''
    if (state.step === 'menu') {
      // Title and the line under it can be replaced on the block;
      // {venue} and {address} fill in this venue's name and address.
      const fill = t => String(t).split('{venue}').join(venue.name).split('{address}').join(venue.address_line1 || '')
      if (!CFG.hideTitle) h += '<h1>' + esc(OPT.title ? fill(OPT.title) : venue.name) + '</h1>'
      if (!OPT.hideSubtitle) {
        h += '<p class="mo-muted">' + (OPT.subtitle ? esc(fill(OPT.subtitle)).split('\n').join('<br>')
          : 'Order for collection' + (venue.address_line1 ? ' · ' + esc(venue.address_line1) : '')) + '</p>'
      }
      if (ord.collection_instructions) h += '<p class="mo-muted">' + esc(ord.collection_instructions) + '</p>'
      h += offersStripHtml()
      if (ord.is_paused) h += '<div class="mo-banner">' + esc(ord.pause_message || 'We are not taking online orders right now. Please check back soon.') + '</div>'
      const q = quote()
      const count = state.basket.reduce((s, l) => s + l.qty, 0)
      h += '<div class="mo-layout"><div>' + menuHtml() + '</div><div class="mo-basket-col"><div class="mo-basket' + (OPT.basketText ? ' mo-fg' : '') + '"><h2 style="margin-top:0;">Your basket</h2>' + basketHtml(false) + '</div></div></div>'
      if (count) h += '<div class="mo-bar"><button class="mo-btn" data-open-basket><span>View basket (' + count + ')</span><span>' + money(q.subtotal_pence - q.discount_pence) + '</span></button></div>'
    } else if (state.step === 'checkout') {
      h += checkoutHtml()
    } else {
      h += payHtml()
      if (state.busy) h += '<p class="mo-muted">Processing&hellip;</p>'
    }
    root.innerHTML = h
    if (state.step === 'menu') spy()
  }

  function openBasketSheet() {
    const back = document.createElement('div')
    back.className = 'mo-sheet-back'
    document.body.appendChild(back)
    const close = () => { back.remove(); document.body.style.overflow = '' }
    document.body.style.overflow = 'hidden'
    const render = () => { back.innerHTML = '<div class="mo-sheet mo-basket-sheet' + (OPT.basketText ? ' mo-fg' : '') + '"><h3>Your basket</h3>' + basketHtml(false) + '<button class="mo-btn mo-btn-ghost mo-btn-block" data-close style="margin-top:8px;">Keep ordering</button></div>' }
    render()
    back.addEventListener('click', e => {
      if (e.target === back) return close()
      const t = e.target.closest('button')
      if (!t) return
      if ('close' in t.dataset) close()
      else if (changeQty(t)) { render(); draw(); if (!state.basket.length) close() }
      else if ('checkout' in t.dataset) { close(); goCheckout() }
      else if (t.dataset.promoDish) { close(); showPromoDish(t.dataset.promoDish, t.dataset.part) }
      else promoClick(t, () => { render(); draw() })
    })
    back.addEventListener('keydown', e => promoKey(e, () => { render(); draw() }))
    back.addEventListener('input', e => { if ('codeInput' in e.target.dataset) state.codeText = e.target.value })
  }

  function changeQty(t) {
    if (t.dataset.inc != null) { state.basket[+t.dataset.inc].qty = Math.min(99, state.basket[+t.dataset.inc].qty + 1) }
    else if (t.dataset.dec != null) {
      const l = state.basket[+t.dataset.dec]
      // Going below the dish's minimum takes the line out altogether.
      const min = minQty(itemsById[l.item_id])
      if (l.qty > 1 && inBasket(l.item_id) - 1 >= min) l.qty -= 1
      else state.basket.splice(+t.dataset.dec, 1)
    } else return false
    saveBasket()
    return true
  }

  function goCheckout() {
    state.step = 'checkout'
    state.error = null
    toAppTop(false)
    loadSlots()
  }

  root.addEventListener('click', e => {
    const t = e.target.closest('button')
    if (!t) return
    if (t.dataset.item) openItem(itemsById[t.dataset.item])
    else if (t.dataset.menu) { state.menuIdx = +t.dataset.menu; draw() }
    else if (t.dataset.jump) jumpTo(t.dataset.jump)
    else if ('clearSearch' in t.dataset) {
      state.q = ''
      draw()
      root.querySelector('[data-search]')?.focus()
    }
    else if ('openSearch' in t.dataset) {
      state.searchOpen = true
      redrawNav()
      root.querySelector('[data-search]')?.focus()
    }
    else if ('closeSearch' in t.dataset) closeSearch()
    else if (changeQty(t)) draw()
    else if ('checkout' in t.dataset) goCheckout()
    else if ('openBasket' in t.dataset) openBasketSheet()
    else if ('back' in t.dataset) { state.step = 'menu'; state.error = null; draw() }
    else if (t.dataset.date) { state.date = t.dataset.date; state.when = null; loadSlots() }
    else if (t.dataset.slot) { state.when = t.dataset.slot; draw() }
    else if (t.dataset.tip != null) { state.tip = +t.dataset.tip; draw() }
    else if ('place' in t.dataset) placeOrder()
    else if (t.dataset.pay) pay(t.dataset.pay)
    else promoClick(t, draw)
  })
  // Swap just the bar (and the dishes, for search) so the page keeps its place.
  function redrawNav() {
    const nav = root.querySelector('.mo-nav')
    if (nav) nav.outerHTML = navHtml()
    spy()
  }
  function closeSearch() {
    state.searchOpen = false
    state.q = ''
    redrawNav()
    const body = root.querySelector('#mo-menu-body')
    if (body) body.innerHTML = menuBodyHtml()
    spy()
  }
  root.addEventListener('keydown', e => {
    if (e.key === 'Escape' && 'search' in e.target.dataset && searchAsIcon()) closeSearch()
  })
  // "Icon on phones": rebuild the bar when the screen crosses the phone width.
  phoneMq.addEventListener?.('change', () => { if (state.step === 'menu' && OPT.searchStyle === 'icon_phone' && OPT.search) redrawNav() })

  root.addEventListener('keydown', e => promoKey(e, draw))
  root.addEventListener('change', e => {
    const d = e.target.dataset
    if (d.when) { state.when = d.when; draw() }
    else if (d.method) { state.method = d.method; draw() }
    else if (d.f === 'marketing_opt_in' || d.f === 'data_consent') { state.form[d.f] = e.target.checked; draw() }
  })
  root.addEventListener('input', e => {
    const d = e.target.dataset
    if ('codeInput' in d) { state.codeText = e.target.value; return }
    if ('search' in d) {
      // Redraw only the tabs and the dishes so the box keeps focus.
      state.q = e.target.value
      const tabsBox = root.querySelector('#mo-nav-tabs')
      const body = root.querySelector('#mo-menu-body')
      if (tabsBox) tabsBox.innerHTML = tabsHtml()
      if (body) {
        body.innerHTML = menuBodyHtml()
        // Scrolled down the menu, the (shorter) results would start above
        // the screen: bring their top back to just under the bar.
        const top = body.getBoundingClientRect().top
        if (top < barBottom()) window.scrollTo({ top: top + window.scrollY - barBottom() - 8 })
      }
      spy()
      return
    }
    if (d.f && d.f !== 'marketing_opt_in' && d.f !== 'data_consent') {
      state.form[d.f] = e.target.value
      // Only the Place order button depends on the form: update it in
      // place so typing never loses focus.
      const btn = root.querySelector('[data-place]')
      if (btn) btn.disabled = !(readyToPlace() && !state.busy)
    }
  })

  draw()

  // Saved codes are checked again; ?promo=CODE (e.g. from the Promo block
  // or an email) opens a code, ?offer=<id> applies a tap-to-apply offer.
  const params = new URLSearchParams(location.search)
  const linkCode = params.get('promo')
  const linkOffer = params.get('offer')
  if (linkOffer && /^[0-9a-f-]{36}$/i.test(linkOffer) && !state.chosen.includes(linkOffer)) state.chosen = [...state.chosen, linkOffer]
  const codes = [...new Set([...(state.savedCodes || []), ...(linkCode ? [linkCode.slice(0, 40)] : [])])]
  if (codes.length) {
    for (const c of codes) {
      try { await checkCode(c) } catch (e) { if (c === linkCode) { state.codeOpen = true; state.codeText = c; state.codeError = e.message } }
    }
  }
  if (linkCode || linkOffer) {
    params.delete('promo')
    params.delete('offer')
    const qs = params.toString()
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash)
  }
  savePromos()
  if (codes.length || linkOffer) draw()
}

// ════════════════════════════════════════════════════════════
//  Payment step (shared by checkout and the status page)
// ════════════════════════════════════════════════════════════
// Switches on payment.type, which the gateway sets. Add a branch here
// when a real gateway is wired in (e.g. 'stripe' mounts Stripe's
// Payment Element with payment.client_secret).

function paymentPanel(payment, money, error) {
  let h = '<h1>Payment</h1>'
  if (error) h += '<div class="mo-error">' + esc(error) + '</div>'
  if (payment.type === 'demo') {
    h += '<div class="mo-panel"><div class="mo-banner" style="margin-top:0;">Test payment: no money will be taken.</div>' +
      '<p style="font-size:1.2rem;font-weight:700;">' + money(payment.amount_pence) + '</p>' +
      '<button class="mo-btn mo-btn-block" data-pay="succeed">Pay ' + money(payment.amount_pence) + '</button>' +
      '<button class="mo-btn mo-btn-ghost mo-btn-block" data-pay="fail" style="margin-top:8px;">Simulate a declined card</button></div>'
  } else {
    h += '<div class="mo-error">This payment method is not available yet. Please contact the restaurant.</div>'
  }
  return h
}

async function runPayment(token, payment, outcome) {
  try {
    const order = await api('/orders/' + token + '/payments/' + payment.payment_id + '/confirm', { method: 'POST', body: { outcome } })
    if (order.payment_status === 'paid') return { done: true }
    return { done: false, error: 'The payment did not go through. Please try again.' }
  } catch (e) {
    return { done: false, error: e.message }
  }
}

// ════════════════════════════════════════════════════════════
//  Status
// ════════════════════════════════════════════════════════════

async function startStatus() {
  const STEPS = [
    ['placed', 'Order received'], ['accepted', 'Accepted'], ['ready', 'Ready to collect'], ['completed', 'Collected'],
  ]
  const RANK = { placed: 0, accepted: 1, preparing: 1, ready: 2, completed: 3 }
  let payState = null
  let order = null

  async function load() {
    try {
      order = await api('/orders/' + CFG.token)
      draw()
    } catch (e) {
      root.innerHTML = '<div class="mo-error">' + esc(e.message) + '</div>'
    }
  }

  function draw() {
    const o = order
    const money = p => formatPence(p, o.currency)
    const tz = o.venue ? o.venue.timezone : 'Europe/London'
    let h = ''
    if (payState) {
      root.innerHTML = paymentPanel(payState.payment, money, payState.error) + (payState.busy ? '<p class="mo-muted">Processing&hellip;</p>' : '')
      return
    }
    h += '<p class="mo-muted">' + esc(o.venue ? o.venue.name : '') + '</p><h1>Order #' + o.order_number + '</h1>'
    if (o.status === 'pending_payment') {
      h += '<div class="mo-banner">Your payment has not gone through yet, so the kitchen has not received this order.</div>' +
        '<button class="mo-btn" data-retry>Pay now</button>'
    } else if (o.status === 'expired') {
      h += '<div class="mo-error">This order was not paid in time and has been cancelled.</div>'
    } else if (o.status === 'rejected' || o.status === 'cancelled') {
      h += '<div class="mo-error">Sorry, this order has been cancelled.' + (o.cancel_reason ? ' ' + esc(o.cancel_reason) : '') + '</div>'
      if (o.refunded_pence) h += '<p>We have refunded ' + money(o.refunded_pence) + '.</p>'
    } else {
      const r = RANK[o.status] ?? 0
      h += '<div class="mo-steps">' + STEPS.map((s, i) => '<div class="mo-step' + (i <= r ? ' is-on' : '') + '"></div>').join('') + '</div>'
      h += '<p style="font-size:1.25rem;font-weight:700;margin:0;">' + esc(STEPS[r][1]) + '</p>'
      if (o.status !== 'completed') {
        h += '<p class="mo-muted">' + (o.status === 'ready' ? 'Your order is waiting for you.' : 'Ready ' + (o.is_asap ? 'around ' : 'at ') + fmtTime(o.promised_at, tz)) + '</p>'
      }
      if (o.payment_status !== 'paid' && o.payment_method === 'pay_at_venue') h += '<p>Please pay when you collect.</p>'
    }
    h += '<div class="mo-panel" style="margin-top:20px;">'
    for (const i of o.items) {
      h += '<div class="mo-line"><div style="flex:1;min-width:0;">' + i.qty + ' &times; <strong>' + esc(i.name) + '</strong>' +
        (i.options.length ? '<div class="mo-line-opts">' + esc(i.options.map(x => x.label).join(', ')) + '</div>' : '') +
        (i.note ? '<div class="mo-line-opts">Note: ' + esc(i.note) + '</div>' : '') +
        '</div><div>' + money(i.line_total_pence) + '</div></div>'
    }
    h += '<div class="mo-row"><span>Subtotal</span><span>' + money(o.subtotal_pence) + '</span></div>'
    for (const p of o.promotions || []) h += '<div class="mo-row mo-disc"><span>' + esc(p.name) + (p.code ? ' (' + esc(p.code) + ')' : '') + '</span><span>&minus;' + money(p.discount_pence) + '</span></div>'
    if (o.tip_pence) h += '<div class="mo-row"><span>Tip</span><span>' + money(o.tip_pence) + '</span></div>'
    h += '<div class="mo-row mo-total"><span>Total</span><span>' + money(o.total_pence) + '</span></div>'
    if (o.vat_pence) h += '<div class="mo-row mo-muted" style="font-size:.9rem;"><span>Includes VAT</span><span>' + money(o.vat_pence) + '</span></div>'
    h += '<p class="mo-muted" style="font-size:.9rem;">' + (o.payment_status === 'paid' ? 'Paid' : o.payment_status === 'refunded' ? 'Refunded' : o.payment_status === 'partially_refunded' ? 'Partly refunded' : 'Not paid yet') + '</p>'
    h += '</div><p class="mo-muted" style="font-size:.9rem;">This page updates by itself. We have also emailed you a confirmation.</p>'
    root.innerHTML = h
  }

  root.addEventListener('click', async e => {
    const t = e.target.closest('button')
    if (!t) return
    if ('retry' in t.dataset) {
      try {
        const res = await api('/orders/' + CFG.token + '/pay', { method: 'POST' })
        if (res.payment) { payState = { payment: res.payment }; draw() }
        else load()
      } catch (err) { alertBox(err.message) }
    } else if (t.dataset.pay && payState) {
      payState.busy = true
      draw()
      const res = await runPayment(CFG.token, payState.payment, t.dataset.pay)
      if (res.done) { payState = null; load() }
      else { payState.busy = false; payState.error = res.error; draw() }
    }
  })

  function alertBox(msg) {
    const d = document.createElement('div')
    d.className = 'mo-error'
    d.textContent = msg
    root.prepend(d)
  }

  await load()
  setInterval(() => { if (!payState && order && !['completed', 'rejected', 'cancelled', 'expired'].includes(order.status)) load() }, 15000)
}
</script>
<% } %>
