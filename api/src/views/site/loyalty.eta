<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="<%= it.colors.primary %>" />
  <title><%= it.programmeName %> – <%= it.brandName %></title>
  <link rel="manifest" href="<%= it.base %>/manifest.webmanifest" />
  <% if (it.faviconUrl) { %><link rel="icon" href="<%= it.faviconUrl %>" /><% } %>
  <style>
    :root {
      --mloy-primary: <%= it.colors.primary %>;
      --mloy-on-primary: <%= it.colors.onPrimary %>;
      --mloy-bg: <%= it.colors.bg %>;
      --mloy-surface: <%= it.colors.surface %>;
      --mloy-text: <%= it.colors.text %>;
      --mloy-muted: <%= it.colors.muted %>;
      --mloy-border: <%= it.colors.border %>;
      --mloy-card-bg: <%= it.colors.cardBg %>;
      --mloy-card-text: <%= it.colors.cardText %>;
      --mloy-card-accent: <%= it.colors.cardAccent %>;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--mloy-bg); color: var(--mloy-text); }
    body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; min-height: 100vh; padding: env(safe-area-inset-top) 16px calc(24px + env(safe-area-inset-bottom)); }
    .wrap { max-width: 480px; margin: 0 auto; }
    header { display: flex; align-items: center; gap: 12px; padding: 18px 0 8px; }
    header img { height: 40px; width: auto; max-width: 140px; object-fit: contain; }
    header .brand { font-weight: 700; font-size: 17px; }
    .foot { text-align: center; font-size: 12px; color: var(--mloy-muted); margin: 24px 0 0; }
  </style>
</head>
<body>
<div class="wrap" id="app" data-loyalty-app>
  <header>
    <% if (it.logoUrl) { %><img src="<%= it.logoUrl %>" alt="<%= it.brandName %>" /><% } else { %><span class="brand"><%= it.brandName %></span><% } %>
  </header>
  <div id="view"></div>
  <p class="foot"><%= it.brandName %> · <%= it.programmeName %></p>
</div>
<script type="module">
/* The card, sign-in and join: assets/loyaltyApp.js, shared with the website's Loyalty card block. */
import { mountLoyalty } from '<%= it.apiBase %>/app.js'
mountLoyalty(document.getElementById('view'), { slug: '<%= it.slug %>', api: '<%= it.apiBase %>', titleTag: 'h1', autofocus: true })
if ('serviceWorker' in navigator) navigator.serviceWorker.register('<%= it.base %>/sw.js', { scope: '<%= it.base %>/' }).catch(() => {})
</script>
</body>
</html>
