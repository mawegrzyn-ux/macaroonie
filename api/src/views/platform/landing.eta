<%
/* The platform site's home page (macaroonie.com/): the message, the six
   feature tiles with their drill-downs, how it fits, the sandboxes, who is
   building it and the register-interest form (site.js sends it to
   POST /api/platform-interest). Head and footer: site/_head.eta, _foot.eta. */
%>
<%~ include('./site/_head', it) %>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">For restaurant groups and franchises</span>
        <h1>Run every venue from one place.</h1>
        <p class="lead">Bookings, the till, kitchen screens, kiosks and the back office on one system, with Pepper, the assistant, doing the busywork.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/features">Take the tour</a>
          <a class="btn btn-ghost" href="#interest">Register interest</a>
        </div>
      </div>
      <figure class="framed hero-shot">
        <%~ include('./site/_shot', { shot: it.shots.till, eager: true, sizes: '(min-width: 1120px) 520px, 100vw' }) %>
      </figure>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2>Six parts, one system</h2>
      <p class="sub">Switch on the parts you need. Tap one to see what it does.</p>
      <%~ include('./site/_tiles', it) %>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>How it fits together</h2>
      <p class="sub">Three layers, each doing one job.</p>
      <div class="steps">
        <div class="step"><div class="n">1</div><h3>At the venue</h3><p>Tills, kitchen screens, kiosks, menu screens and printers, on tablets and screens you can buy anywhere.</p></div>
        <div class="step"><div class="n">2</div><h3>The venue hub</h3><p>A small computer that keeps the venue trading and printing when the internet drops.</p></div>
        <div class="step"><div class="n">3</div><h3>The cloud</h3><p>One system for every venue and business, each one's data walled off from the rest.</p></div>
      </div>
      <p class="band-link"><a class="btn btn-light" href="/architecture">See how it works</a></p>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <h2>Try it</h2>
      <p class="sub">Small sandboxes of the real designers, coming next.</p>
      <div class="cards two">
        <% it.tryPages.forEach(function (p) { %>
          <a class="card try-card" href="/try">
            <%~ include('./site/_shot', { shot: it.shots[p.shot], sizes: '(min-width: 1120px) 540px, 100vw' }) %>
            <span class="pad">
              <% if (p.soon) { %><span class="badge">Coming next</span><% } %>
              <span class="h3"><%= p.short %></span>
              <span class="p"><%= p.description %></span>
            </span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="team" id="team">
    <div class="wrap">
      <div>
        <h2>Who's building Macaroonie</h2>
        <p class="body">We're a small team with more than 25 years in hospitality. We started as operators, running chain restaurants, hotels, and independent pubs and restaurants, before moving into technology.</p>
        <p class="body">Since then we've delivered technology for multi-site businesses: restaurant franchises, gyms, attractions and racecourses, in the UK, across Europe and in the US. We've worked hand in hand with operations, finance, HR, marketing, procurement and the kitchen, so we know how a site really runs, from the opening checks to the end-of-week cash-up.</p>
        <p class="body">Our strength is talking to everyone: crew on the floor, site and area managers, head office and the board. We turn what each of them needs into tools that hold up on a busy Friday night, and bring people with us through the change.</p>
        <p class="body">Macaroonie is the platform we wanted when we were running sites ourselves: one place for the whole operation, made for the people who run it every day.</p>
      </div>
      <div class="facts">
        <div class="fact"><b>25+ years</b><span>in hospitality, operations first, then technology</span></div>
        <div class="fact"><b>Every department</b><span>operations, finance, HR, marketing and the kitchen</span></div>
        <div class="fact"><b>Floor to board</b><span>at home with site teams and leadership alike</span></div>
        <div class="fact"><b>Operators first</b><span>chain restaurants, hotels, pubs and independents</span></div>
      </div>
    </div>
  </section>

  <section class="interest" id="interest">
    <div class="wrap">
      <div>
        <h2>Register your interest</h2>
        <p class="sub">We're taking on our first groups and franchisees. Leave your details and we'll be in touch to show you round.</p>
        <ul class="ticks">
          <li>A walkthrough with your own locations and menus</li>
          <li>Help moving your bookings, menus and staff across</li>
          <li>No obligation</li>
        </ul>
      </div>
      <form class="card" id="interest-form" novalidate>
        <div id="interest-fields">
          <div class="row2">
            <label class="f">Your name <span class="req">*</span><input name="name" autocomplete="name" required maxlength="200"></label>
            <label class="f">Email <span class="req">*</span><input name="email" type="email" autocomplete="email" required maxlength="320"></label>
          </div>
          <div class="row2">
            <label class="f">Company or brand<input name="company" autocomplete="organization" maxlength="200"></label>
            <label class="f">Phone<input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="50"></label>
          </div>
          <label class="f">Number of sites
            <select name="sites">
              <option value="">Choose…</option>
              <option>1</option>
              <option>2 to 5</option>
              <option>6 to 20</option>
              <option>21 or more</option>
            </select>
          </label>
          <label class="f">Anything we should know?<textarea name="message" maxlength="4000" placeholder="What you'd like to use, which systems you use today…"></textarea></label>
          <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <label class="check"><input type="checkbox" name="consent"><span>I agree that Macaroonie may store these details and contact me about the platform. We won't share them or use them for anything else.</span></label>
          <button class="btn btn-primary" type="submit" id="interest-submit" style="width:100%">Register interest</button>
          <p class="msg" id="interest-msg" role="status" aria-live="polite"></p>
        </div>
        <div class="thanks" id="interest-thanks" hidden>
          <h3>Thank you</h3>
          <p>We've got your details and will be in touch soon.</p>
        </div>
      </form>
    </div>
  </section>
<%~ include('./site/_foot', it) %>
