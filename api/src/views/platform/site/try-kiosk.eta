<%~ include('./_head', it) %>
<%
/* The kiosk designer demo (/try/kiosk): the office's real kiosk designer
   with an invented menu, framed full width. It is a build of its own
   (admin/vite.demo.config.js), served from it.demoPages.designer
   (services/platformSite/demoBuilds.js); its preview is the real kiosk app
   in demo mode (pos/vite.demo.config.js). Nothing is sent to the API. */
%>
<section class="page-hero try-hero">
  <div class="wrap">
    <p class="crumbs"><a href="/try">Try it</a></p>
    <h1>Design a kiosk</h1>
    <p class="lead">This is the kiosk designer from Macaroonie, with a menu we made up for Harbour &amp; Co. Change the colours, fonts and layout, give the dishes pictures (ours or your own), then tap through the kiosk beside it as a guest would.</p>
  </div>
</section>
<section class="kd-demo" aria-label="Kiosk designer">
  <iframe class="kd-demo-frame" src="<%= it.demoPages.designer %>" title="Kiosk designer demo" data-testid="kd-demo-frame"></iframe>
  <noscript><p class="wrap">The designer needs JavaScript. The <a href="/screenshots">screenshots</a> show the real kiosk.</p></noscript>
</section>
<%~ include('./_foot', it) %>
