# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/macaroonie_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging (optional) ────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent. Unset: info in
# production, debug otherwise. The API tests (npm test) use silent.
# LOG_LEVEL=info

# ── Auth0 ─────────────────────────────────────────────────────
# Domain from your Auth0 tenant (no https://)
AUTH0_DOMAIN=macaroonie.eu.auth0.com
# API identifier from Auth0 → Applications → APIs
AUTH0_AUDIENCE=https://api.macaroonie.com

# ── Auth0 Management API (for in-app team + tenant provisioning) ─
# Create a Machine-to-Machine app in Auth0 → Applications → APIs →
# Auth0 Management API → "Machine to Machine Applications" tab.
# Authorise scopes:
#
#   Team invites / management:
#     read:users, update:users, read:organization_invitations,
#     create:organization_invitations, read:organization_members,
#     delete:organization_member_roles, delete:organization_members
#
#   Auto-provisioning new tenants from /platform (optional but recommended):
#     create:organizations, update:organizations, read:organizations,
#     read:connections, create:organization_connections,
#     update:organization_connections
#
# Leave these blank in dev to disable both features (Team page invites
# locally only; tenant creation requires manual Auth0 org id paste).
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# SPA client_id users land in after accepting an invitation.
# Same value as VITE_AUTH0_CLIENT_ID in admin/.env.
AUTH0_INVITE_CLIENT_ID=

# ── Stripe ────────────────────────────────────────────────────
# Card payments (online ordering, booking deposits, card machines) through
# each group's own Stripe account (Connect): the platform's secret key, the
# publishable key, and the signing secret of the Connect webhook endpoint
# (https://<api host>/webhooks/payments/stripe, events from connected
# accounts: payment_intent.succeeded / payment_failed / canceled,
# account.updated, account.application.deauthorized). Can be saved on the
# Platform page (Payments) instead.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ── Email ─────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@macaroonie.com
# Optional: email each register-interest form from the platform page (macaroonie.com) here
# INTEREST_NOTIFY_EMAIL=you@example.com

# ── Stored keys (migration 179) ───────────────────────────────
# Seals the integration keys stored in the database (Anthropic, Loyverse,
# GloriaFood, email providers): 32 bytes, base64 or hex. Required in
# production; every deploy adds one when missing (scripts/ensure-secrets-key.sh)
# and never changes it. Back it up with this file.
# SECRETS_KEY=   (openssl rand -base64 32)

# ── AI assistant (migration 148) ──────────────────────────────
# Optional. Unset = the staff assistant and the website chat are off (the
# MCP connectors still work). Usage is counted per tenant against the
# monthly limit set on the Platform page.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=      (default in src/config/env.js: the main model)
# AI_MODEL_FAST= (default in src/config/env.js: the everyday model chats
#                start on; set it empty to keep every chat on AI_MODEL)
# AI_EFFORT=medium

# Loyverse POS API (Cash Recon > Loyverse). Tokens are per tenant, saved in the app;
# only change this to test against a stand-in server.
# LOYVERSE_API_URL=https://api.loyverse.com/v1.0

# GloriaFood online orders: poll keys are per venue (Cash Recon settings >
# GloriaFood); only change this to test against a stand-in server.
# GLORIAFOOD_API_URL=https://pos.globalfoodsoft.com

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
